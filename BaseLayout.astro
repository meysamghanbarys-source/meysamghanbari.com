---
import '../styles/global.css';
import { nav, site } from '../data/site';

interface Props {
  title: string;
  description: string;
  lang?: 'en' | 'fa';
  path?: string;
}

const {
  title,
  description,
  lang = 'en',
  path = '/'
} = Astro.props;

const isFa = lang === 'fa';
const dir = isFa ? 'rtl' : 'ltr';
const canonicalPath = path.startsWith('/') ? path : `/${path}`;
const canonical = `${site.domain}${canonicalPath === '/' ? '' : canonicalPath}`;
const alternatePath = isFa
  ? (canonicalPath === '/fa/' || canonicalPath === '/fa' ? '/' : canonicalPath.replace(/^\/fa/, ''))
  : (canonicalPath === '/' ? '/fa/' : `/fa${canonicalPath}`);
const alternate = `${site.domain}${alternatePath === '/' ? '' : alternatePath}`;
const pageTitle = title === site.name ? title : `${title} | ${site.name}`;
const items = isFa ? nav.fa : nav.en;
const homeHref = isFa ? '/fa/' : '/';
const contactHref = isFa ? '/fa/contact' : '/contact';
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: site.domain,
  jobTitle: site.role.en
};
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#08111f" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={isFa ? 'en' : 'fa'} href={alternate} />
    <link rel="alternate" hreflang={isFa ? 'fa' : 'en'} href={canonical} />
    <link rel="alternate" hreflang="x-default" href={`${site.domain}`} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={isFa ? 'fa_IR' : 'en_US'} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)}></script>
  </head>
  <body>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href={homeHref} aria-label={`${site.name} home`}>
          <span class="brand-mark">MG</span>
          <span class="brand-name">{site.name}</span>
        </a>

        <nav class="desktop-nav" aria-label="Primary navigation">
          {items.map(([id, label]) => (
            <a href={isFa ? `/fa/${id}` : `/${id}`}>{label}</a>
          ))}
        </nav>

        <div class="header-actions">
          <a class="language-link" href={alternatePath}>{isFa ? 'EN' : 'FA'}</a>
          <a class="button small" href={contactHref}>{isFa ? 'همکاری' : 'Collaborate'}</a>
        </div>

        <details class="mobile-nav">
          <summary aria-label="Open navigation">☰</summary>
          <div class="mobile-panel">
            {items.map(([id, label]) => (
              <a href={isFa ? `/fa/${id}` : `/${id}`}>{label}</a>
            ))}
            <a href={alternatePath}>{isFa ? 'English' : 'فارسی'}</a>
          </div>
        </details>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell footer-grid">
        <div>
          <a class="brand footer-brand" href={homeHref}>
            <span class="brand-mark">MG</span>
            <span class="brand-name">{site.name}</span>
          </a>
          <p>{isFa ? site.role.fa : site.role.en}</p>
        </div>
        <div>
          <strong>{isFa ? 'تمرکز' : 'Focus'}</strong>
          <p>{isFa ? 'Optical · Satellite · Photonics · AI' : 'Optical · Satellite · Photonics · AI'}</p>
        </div>
        <div>
          <strong>{isFa ? 'ارتباط' : 'Contact'}</strong>
          <p><a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a></p>
        </div>
      </div>
      <div class="shell footer-bottom">
        <span>© {new Date().getFullYear()} {site.name}</span>
        <span>{isFa ? 'ساخته‌شده برای رشد بلندمدت یک برند پژوهشی.' : 'Built as a long-term research brand asset.'}</span>
      </div>
    </footer>
  </body>
</html>
