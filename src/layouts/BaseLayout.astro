---
import '../styles/global.css';
import { nav, site } from '../data/site';

interface Props {
  title: string;
  description: string;
  lang?: 'en' | 'fa';
  path?: string;
  image?: string;
  imageAlt?: string;
  ogType?: 'website' | 'article';
  alternateAvailable?: boolean;
  languagePath?: string;
}

const {
  title,
  description,
  lang = 'en',
  path = '/',
  image = site.ogImage,
  imageAlt = `${site.name} — ${site.role.en}`,
  ogType = 'website',
  alternateAvailable = true,
  languagePath
} = Astro.props;

const isFa = lang === 'fa';
const dir = isFa ? 'rtl' : 'ltr';
const canonicalPath = path.startsWith('/') ? path : `/${path}`;
const canonical = `${site.domain}${canonicalPath === '/' ? '' : canonicalPath}`;
const alternatePath = languagePath ?? (isFa
  ? (canonicalPath === '/fa/' || canonicalPath === '/fa' ? '/' : canonicalPath.replace(/^\/fa/, ''))
  : (canonicalPath === '/' ? '/fa/' : `/fa${canonicalPath}`));
const alternate = `${site.domain}${alternatePath === '/' ? '' : alternatePath}`;
const pageTitle = title === site.name
  ? `${site.name} | Optical & Satellite Communications Researcher`
  : `${title} | ${site.name}`;
const items = isFa ? nav.fa : nav.en;
const homeHref = isFa ? '/fa/' : '/';
const contactHref = isFa ? '/fa/contact' : '/contact';
const currentSection = canonicalPath.replace(/^\/fa\/?/, '/').split('/').filter(Boolean)[0] ?? 'home';
const breadcrumbParts = canonicalPath.split('/').filter(Boolean).filter((part) => part !== 'fa');
const breadcrumbs = [
  { '@type': 'ListItem', position: 1, name: 'Home', item: site.domain },
  ...breadcrumbParts.map((part, index) => ({
    '@type': 'ListItem',
    position: index + 2,
    name: part.replace(/-/g, ' ').replace(/\b\w/g, (letter) => letter.toUpperCase()),
    item: `${site.domain}/${breadcrumbParts.slice(0, index + 1).join('/')}`
  }))
];

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${site.domain}/#website`,
      url: site.domain,
      name: site.name,
      alternateName: site.alternateName
    },
    {
      '@type': 'Person',
      '@id': `${site.domain}/#person`,
      name: site.name,
      alternateName: site.alternateName,
      url: site.domain,
      image: `${site.domain}${site.heroImage}`,
      jobTitle: site.role.en,
      email: site.contactEmail,
      knowsAbout: site.knowsAbout,
      sameAs: Object.values(site.socialLinks).filter(Boolean)
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumbs
    }
  ]
};
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#050b13" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <link rel="canonical" href={canonical} />
    {alternateAvailable && <link rel="alternate" hreflang={isFa ? 'en' : 'fa'} href={alternate} />}
    <link rel="alternate" hreflang={isFa ? 'fa' : 'en'} href={canonical} />
    <link rel="alternate" hreflang="x-default" href={site.domain} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={isFa ? 'fa_IR' : 'en_US'} />
    <meta property="og:image" content={`${site.domain}${image}`} />
    <meta property="og:image:alt" content={imageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${site.domain}${image}`} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href={homeHref} aria-label={`${site.name} home`}>
          <span class="brand-mark">MG</span>
          <span class="brand-name">{site.name}</span>
        </a>

        <nav class="desktop-nav" aria-label="Primary navigation">
          {items.map(([id, label]) => (
            <a href={isFa ? `/fa/${id}` : `/${id}`} aria-current={currentSection === id ? 'page' : undefined}>{label}</a>
          ))}
        </nav>

        <div class="header-actions">
          <a class="language-link" href={alternatePath}>{isFa ? 'EN' : 'FA'}</a>
          <a class="button small" href={contactHref}>{isFa ? 'ارتباط' : 'Contact'}</a>
        </div>

        <details class="mobile-nav">
          <summary aria-label="Open navigation">☰</summary>
          <div class="mobile-panel">
            {items.map(([id, label]) => (
              <a href={isFa ? `/fa/${id}` : `/${id}`} aria-current={currentSection === id ? 'page' : undefined}>{label}</a>
            ))}
            <a href={alternatePath}>{isFa ? 'English' : 'فارسی'}</a>
          </div>
        </details>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell footer-grid">
        <div>
          <a class="brand footer-brand" href={homeHref}>
            <span class="brand-mark">MG</span>
            <span class="brand-name">{site.name}</span>
          </a>
          <p>{isFa ? site.role.fa : site.role.en}</p>
        </div>
        <div>
          <strong>{isFa ? 'تمرکز' : 'Research focus'}</strong>
          <p>OISL · FSO · Receiver Design · PAT · NTN · Quantum · AI</p>
        </div>
        <div>
          <strong>{isFa ? 'ارتباط پژوهشی' : 'Research enquiries'}</strong>
          <p><a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a></p>
          {site.socialLinks.orcid && <p><a href={site.socialLinks.orcid} target="_blank" rel="me noreferrer">ORCID profile ↗</a></p>}
        </div>
      </div>
      <nav class="shell footer-nav" aria-label="Footer navigation">
        {items.map(([id, label]) => <a href={isFa ? `/fa/${id}` : `/${id}`}>{label}</a>)}
      </nav>
      <div class="shell footer-bottom">
        <span>© {new Date().getFullYear()} {site.name}</span>
        <span>{isFa ? 'وب‌سایت رسمی پژوهشی' : 'Official research website'}</span>
      </div>
    </footer>
  </body>
</html>
