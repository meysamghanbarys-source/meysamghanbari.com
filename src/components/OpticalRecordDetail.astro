---
import BaseLayout from '../layouts/BaseLayout.astro';
import { opticalRecords, recordCategories, statusLabels, type OpticalRecord } from '../data/optical-records';
import { site } from '../data/site';

interface Props { lang: 'en' | 'fa'; record: OpticalRecord }
const { lang, record } = Astro.props;
const isFa = lang === 'fa';
const prefix = isFa ? '/fa' : '';
const basePath = `${prefix}/research/optical-communications-records`;
const path = `${basePath}/${record.slug}/`;
const alternatePath = `${isFa ? '' : '/fa'}/research/optical-communications-records/${record.slug}/`;
const description = record.summary[lang];
const primaryCategory = recordCategories.find((category) => category.id === record.categoryIds[0]);
const related = opticalRecords.filter((item) => item.slug !== record.slug && item.categoryIds.some((category) => record.categoryIds.includes(category))).slice(0, 3);
const isFuture = record.status === 'announced-target';
const labels = isFa ? {
  back: 'رصدخانه رکوردها', evidence: 'شواهد کلیدی', how: isFuture ? 'معماری هدف' : 'چگونه انجام شد',
  why: 'چرا اهمیت دارد', caution: 'مرز ادعا و مقایسه', sources: 'منابع و مراجع', sourceNote: 'اعداد این پرونده از منابع زیر استخراج شده‌اند. برای ادعای رکورد، متن منبع اولیه ملاک بوده است.',
  related: 'پرونده‌های مرتبط', project: 'پژوهش مرتبط میثم قنبری', discuss: 'درباره یک مسئلهٔ مرتبط گفتگو کنید',
  cta: 'برای همکاری پژوهشی، تحقیق‌وتوسعه صنعتی یا بحث فنی دربارهٔ لینک‌های نوری و ماهواره‌ای می‌توان از مسیر ارتباط حرفه‌ای استفاده کرد.',
  contact: 'ارتباط پژوهشی', holder: 'تیم / سامانه', geometry: 'هندسهٔ لینک', platform: 'سکو', year: 'سال / برنامه',
  futureNotice: 'این یک هدف اعلام‌شده است، نه رکورد محقق‌شده.'
} : {
  back: 'Record observatory', evidence: 'Evidence snapshot', how: isFuture ? 'Target architecture' : 'How it was achieved',
  why: 'Why it matters', caution: 'Claim and comparison boundary', sources: 'Sources & references', sourceNote: 'The values in this file are traced to the sources below. Record language follows the wording supported by the primary evidence.',
  related: 'Related record files', project: 'Related research by Meysam Ghanbari', discuss: 'Discuss a related technical problem',
  cta: 'Research collaboration, industrial R&D and technical discussions concerning optical and satellite links can be directed through the professional contact pathway.',
  contact: 'Research contact', holder: 'Team / system', geometry: 'Link geometry', platform: 'Platform', year: 'Year / programme',
  futureNotice: 'This is an announced target, not an achieved record.'
};
const schema = {
  '@context': 'https://schema.org', '@type': 'TechArticle',
  headline: record.title[lang], description, image: `${site.domain}${record.image}`,
  mainEntityOfPage: `${site.domain}${path}`, dateModified: '2026-09-19',
  author: { '@type': 'Person', '@id': `${site.domain}/#person`, name: site.name },
  publisher: { '@type': 'Person', '@id': `${site.domain}/#person`, name: site.name },
  about: record.categoryIds.map((id) => recordCategories.find((category) => category.id === id)?.en).filter(Boolean),
  citation: record.sources.map((source) => source.url)
};
---

<BaseLayout title={record.title[lang]} description={description} lang={lang} path={path} languagePath={alternatePath} image={record.image} imageAlt={record.imageAlt[lang]} ogType="article" breadcrumbNames={isFa ? ['پژوهش', 'رصدخانه رکوردها', record.title.fa] : ['Research', 'Record Observatory', record.title.en]}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schema)}></script>
  <article class="record-detail">
    <header class="record-detail-hero">
      <div class="shell record-detail-hero-grid">
        <div>
          <a class="back-link" href={`${basePath}/`}>← {labels.back}</a>
          <div class="record-detail-kicker"><span>{primaryCategory?.code}</span><span class={`record-status status-${record.status}`}>{statusLabels[record.status][lang]}</span><span>{record.year}</span></div>
          <h1>{record.title[lang]}</h1>
          <p>{record.summary[lang]}</p>
          {isFuture && <div class="future-warning">{labels.futureNotice}</div>}
        </div>
        <div class="record-detail-metric"><span>{isFa ? 'شاخص اصلی' : 'Primary metric'}</span><strong>{record.metric[lang]}</strong><small>{record.distance[lang]}</small></div>
      </div>
    </header>

    <section class="record-fact-strip"><div class="shell"><dl><div><dt>{labels.holder}</dt><dd>{record.holder[lang]}</dd></div><div><dt>{labels.geometry}</dt><dd>{record.distance[lang]}</dd></div><div><dt>{labels.platform}</dt><dd>{record.platform[lang]}</dd></div><div><dt>{labels.year}</dt><dd>{record.year}</dd></div></dl></div></section>

    <section class="section record-detail-story"><div class="shell record-detail-grid">
      <div class="record-detail-main">
        <figure class="record-figure"><img src={record.image} alt={record.imageAlt[lang]} width="1200" height="700" loading="eager" /><figcaption>{record.title[lang]} · {statusLabels[record.status][lang]}</figcaption></figure>
        <section><p class="eyebrow">01 · SYSTEM</p><h2>{labels.how}</h2><p>{record.how[lang]}</p></section>
        <section><p class="eyebrow">02 · EVIDENCE</p><h2>{labels.evidence}</h2><ol class="record-evidence-list">{record.evidence[lang].map((item, index) => <li><span>{String(index + 1).padStart(2, '0')}</span><p>{item}</p></li>)}</ol></section>
        <section><p class="eyebrow">03 · SIGNIFICANCE</p><h2>{labels.why}</h2><p>{record.significance[lang]}</p></section>
        <aside class="record-caveat"><p class="eyebrow">04 · SCOPE</p><h2>{labels.caution}</h2><p>{record.caveat[lang]}</p></aside>
        <section class="record-sources"><p class="eyebrow">05 · REFERENCES</p><h2>{labels.sources}</h2><p>{labels.sourceNote}</p><div>{record.sources.map((source, index) => <a href={source.url} target="_blank" rel="noreferrer"><span>{String(index + 1).padStart(2, '0')}</span><div><strong>{source.title}</strong><small>{source.organization} · {source.kind}</small></div><b>↗</b></a>)}</div></section>
      </div>
      <aside class="record-detail-sidebar">
        <div class="record-side-card"><span>{isFa ? 'طبقه‌بندی' : 'Classification'}</span>{record.categoryIds.map((id) => { const category = recordCategories.find((item) => item.id === id); return category && <a href={`${basePath}/#${category.id}`}>{category[lang]} <b>{category.code}</b></a>; })}</div>
        {record.relatedProject && record.relatedProjectLabel && <div class="record-side-card accent"><span>{labels.project}</span><strong>{record.relatedProjectLabel[lang]}</strong><p>{isFa ? 'یک مسیر پژوهشی مرتبط در معماری گیرنده، شبکهٔ نوری یا انتقال انرژی.' : 'A related research direction in receiver architecture, optical networking or energy transfer.'}</p><a class="text-link" href={isFa ? '/fa/projects' : record.relatedProject}>{isFa ? 'مشاهده پروژه‌ها ←' : 'Explore project →'}</a></div>}
        <div class="record-side-card"><span>{isFa ? 'یادداشت روش' : 'Method note'}</span><p>{isFa ? 'نبود دادهٔ عمومی یا تفاوت کلاس لینک، دلیل کافی برای ساختن رتبه‌بندی قطعی نیست.' : 'Missing public data or incompatible link classes are not a basis for inventing a definitive ranking.'}</p></div>
      </aside>
    </div></section>

    <section class="section record-related-files"><div class="shell"><p class="eyebrow">{labels.related}</p><div class="record-related-cards">{related.map((item) => <a href={`${basePath}/${item.slug}/`}><span>{statusLabels[item.status][lang]}</span><strong>{item.metric[lang]}</strong><h3>{item.title[lang]}</h3><small>{item.year} ↗</small></a>)}</div></div></section>
    <section class="record-detail-cta"><div class="shell"><div><p class="eyebrow">{labels.discuss}</p><h2>{labels.project}</h2><p>{labels.cta}</p></div><a class="button" href={`${prefix}/contact`}>{labels.contact}</a></div></section>
  </article>
</BaseLayout>
