---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { publications, projects, upcoming } from '../data/library';
import { engineeringPaths } from '../data/future-systems';
const today = new Date().toISOString().slice(0, 10);
const event = upcoming.find(item => item.endDate >= today);
const quantumPaper = publications.find(item => item.slug === 'city-scale-quantum-timing-wireless-synchronization-quantum-hubs')!;
const selectedPapers = [publications[1], quantumPaper, publications[0]];
const spotlight = [
  ...(event ? [{ id:'upcoming-vtc', kind:'Upcoming', title:'IEEE VTC 2027-Spring', detail:`${event.date} · ${event.location}`, href:'/upcoming/', action:'View presentation', expires:event.endDate }] : []),
  { id:quantumPaper.slug, kind:'Publication · Published', title:'Toward City-Scale Quantum Timing', detail:'Wireless synchronization via quantum hubs · IEEE JSAC', href:`/publications/${quantumPaper.slug}/`, action:'Read the research', expires:undefined },
  { id:'optical-record-observatory', kind:'Technical resource', title:'Optical Record Observatory', detail:'Demonstrated capabilities, operational links and future targets.', href:'/research/optical-communications-records/', action:'Explore the evidence', expires:undefined }
];
---
<BaseLayout title={site.name} description="Meysam Ghanbari researches advanced communications for space, optical and quantum networks. Explore publications, technical systems and collaboration." path="/" image={site.heroImage} imageAlt="Portrait of Meysam Ghanbari">
  <section class="brand-hero">
    <div class="shell brand-hero-grid">
      <div class="brand-hero-copy">
        <p class="brand-kicker">SPACE · OPTICAL · QUANTUM</p>
        <p class="brand-identity">Meysam Ghanbari</p>
        <h1>Advanced Communications for Space, Optical and Quantum Networks</h1>
        <p class="brand-lede">Meysam Ghanbari studies the architectures, physical limits and engineering choices that connect future space, optical and quantum networks.</p>
        <div class="brand-actions"><a class="button" href="/contact/">Discuss a collaboration <span aria-hidden="true">↗</span></a><a class="button ghost" href="/research/">Explore technology</a></div>
        <p class="brand-hero-note">Research · Industry R&D · Technical speaking</p>
      </div>
      <figure class="brand-portrait">
        <img src={site.heroImage} alt="Portrait of Meysam Ghanbari" width="1024" height="1536" loading="eager" fetchpriority="high" />
        <figcaption><span>MEYSAM GHANBARI</span><strong>Communications researcher</strong></figcaption>
      </figure>
    </div>
  </section>

  <section class="brand-spotlight" aria-labelledby="spotlight-title">
    <div class="shell"><div class="brand-section-label"><h2 id="spotlight-title">In focus</h2><span>Research, events & technical perspectives</span></div>
      <div class="brand-spotlight-grid">{spotlight.map(item => <a class="brand-spotlight-card" href={item.href} data-spotlight-id={item.id} data-expires={item.expires}><span class="brand-kicker">{item.kind}</span><h3>{item.title}</h3><p>{item.detail}</p><strong>{item.action} <span aria-hidden="true">→</span></strong></a>)}</div>
    </div>
  </section>

  <section class="brand-section"><div class="shell">
    <div class="brand-section-heading"><div><p class="brand-kicker">THE TECHNOLOGY</p><h2>From a physical link<br />to a connected system.</h2></div><p>The portfolio connects communication theory with network architecture, optical hardware constraints and emerging quantum infrastructure.</p></div>
    <div class="brand-domain-grid">
      <a href="/research/"><span class="brand-number">01 / SPACE</span><h3>Space & NTN networks</h3><p>Satellite crosslinks, aerial platforms and communication architectures across non-terrestrial networks.</p><strong>Explore research →</strong></a>
      <a href="/projects/"><span class="brand-number">02 / OPTICAL</span><h3>Optical communication systems</h3><p>Free-space optical links, regenerative relays, receiver architecture and the alignment limits of narrow beams.</p><strong>Explore projects →</strong></a>
      <a href={`/publications/${quantumPaper.slug}/`}><span class="brand-number">03 / QUANTUM</span><h3>Quantum networks & timing</h3><p>Quantum hubs, synchronization, satellite QKD and the communication layers of quantum infrastructure.</p><strong>Explore a publication →</strong></a>
    </div>
  </div></section>

  <section class="brand-section brand-section-tinted"><div class="shell">
    <div class="brand-section-heading"><div><p class="brand-kicker">PUBLICATIONS</p><h2>Research, on the record.</h2></div><a class="brand-text-link" href="/publications/">View all {publications.length} publications →</a></div>
    <div class="brand-publication-list">{selectedPapers.map(paper => <a href={`/publications/${paper.slug}/`}><div class="brand-paper-meta"><span>{paper.type} · {paper.year}</span><span class={`status-pill status-${paper.status.toLowerCase()}`}>{paper.status}</span></div><h3>{paper.title}</h3><p>{paper.venue}</p><span class="brand-paper-arrow" aria-hidden="true">↗</span></a>)}</div>
  </div></section>

  <section class="brand-section"><div class="shell">
    <div class="brand-section-heading"><div><p class="brand-kicker">FUTURE SYSTEMS</p><h2>Engineering the next connection.</h2></div><p>Reading paths through existing technical research and source-backed records, from space optical networks to quantum timing.</p></div>
    <div class="brand-path-grid">{engineeringPaths.slice(0,2).map(item => <a href={item.href}><figure><img src={item.image} alt={item.imageAlt} width="1672" height="941" loading="lazy" /><figcaption>Concept illustration</figcaption></figure><div><span class="brand-kicker">{item.category}</span><h3>{item.title}</h3><p>{item.description}</p><strong>{item.label} →</strong></div></a>)}</div>
    <a class="brand-text-link brand-more" href="/insights/">Explore Future Systems →</a>
  </div></section>

  <section class="brand-collaboration"><div class="shell"><div><p class="brand-kicker">CONNECT THE IDEAS</p><h2>A research question.<br />An engineering challenge.<br />A useful conversation.</h2><p>For research collaboration, industrial R&D and technical speaking enquiries, contact Meysam Ghanbari.</p></div><a class="button" href="/contact/">Start a conversation ↗</a></div></section>
  <script>
    // Prevent a past event from remaining in the homepage spotlight between deployments.
    const today = new Date().toISOString().slice(0, 10);
    document.querySelectorAll<HTMLElement>('[data-expires]').forEach(card => {
      if (card.dataset.expires && card.dataset.expires < today) card.remove();
    });
  </script>
</BaseLayout>
<style>
.brand-hero { padding:58px 0 54px; position:relative; overflow:hidden; background:radial-gradient(ellipse at 75% 20%,#13314a88,transparent 62%),#050b13; border-bottom:1px solid var(--line); }
.brand-hero-grid { display:grid; grid-template-columns:minmax(0,1fr) 326px; align-items:center; gap:76px; }
.brand-kicker { margin:0; color:#83dff5; font-size:11px; font-weight:750; letter-spacing:.15em; text-transform:uppercase; }
.brand-identity { font-size:23px; margin:19px 0 12px; font-weight:600; color:#d6e0ec; }
.brand-hero h1 { max-width:730px; margin:0; font-size:clamp(35px,4.05vw,57px); line-height:1.08; letter-spacing:-.045em; text-wrap:balance; }
.brand-lede { max-width:610px; color:#b8c6d8; font-size:17px; line-height:1.65; margin:23px 0 25px; }
.brand-actions { display:flex; flex-wrap:wrap; gap:12px; }
.brand-hero-note { color:#a0b1c6; font-size:12px; margin:19px 0 0; }
.brand-portrait { margin:0; position:relative; border:1px solid #4b607655; border-radius:5px; overflow:hidden; background:#152232; }
.brand-portrait img { width:100%; aspect-ratio:3/4; object-fit:cover; object-position:center 24%; display:block; }
.brand-portrait figcaption { position:absolute; bottom:0; left:0; right:0; padding:52px 22px 20px; background:linear-gradient(transparent,#040b14ed); }
.brand-portrait span { color:#ccdfef; display:block; font-size:10px; letter-spacing:.15em; margin-bottom:5px; }
.brand-portrait strong { font-size:15px; font-weight:500; }
.brand-spotlight { padding:26px 0 38px; background:#081320; border-bottom:1px solid var(--line); }
.brand-section-label { display:flex; justify-content:space-between; align-items:center; gap:20px; margin-bottom:18px; }
.brand-section-label h2 { font-size:17px; margin:0; letter-spacing:-.01em; }
.brand-section-label > span { font-size:12px; color:#aabbd0; }
.brand-spotlight-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(240px,1fr)); gap:13px; }
.brand-spotlight-card { padding:23px; border:1px solid #324256; border-radius:4px; display:flex; flex-direction:column; min-width:0; background:#0a1727; }
.brand-spotlight-card:hover { border-color:#6fbdcf; background:#0c1e31; }
.brand-spotlight-card h3 { font-size:21px; line-height:1.2; margin:12px 0 10px; letter-spacing:-.025em; }
.brand-spotlight-card p { color:#b1c1d3; font-size:13px; line-height:1.55; margin:0 0 20px; }
.brand-spotlight-card strong { color:#9be3f5; margin-top:auto; font-size:12px; font-weight:600; }
.brand-section { padding:80px 0; }
.brand-section-tinted { background:#08111e; border-block:1px solid var(--line); }
.brand-section-heading { display:flex; justify-content:space-between; align-items:end; gap:50px; margin-bottom:32px; }
.brand-section-heading h2 { margin:12px 0 0; font-size:clamp(29px,3.4vw,44px); line-height:1.12; letter-spacing:-.035em; }
.brand-section-heading > p { max-width:430px; color:#b5c3d5; margin:0; line-height:1.65; font-size:15px; }
.brand-domain-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:22px; }
.brand-domain-grid > a { padding:28px 0 20px; border-top:1px solid #435267; }
.brand-number { font-size:11px; color:#85cfe3; letter-spacing:.1em; }
.brand-domain-grid h3 { font-size:24px; line-height:1.2; margin:19px 0 13px; letter-spacing:-.03em; }
.brand-domain-grid p { color:#b5c3d5; line-height:1.65; font-size:14px; }
.brand-domain-grid strong, .brand-path-grid strong, .brand-text-link { display:inline-flex; align-items:center; min-height:44px; color:#9be3f5; font-size:13px; font-weight:650; }
.brand-publication-list { border-top:1px solid #435267; }
.brand-publication-list > a { display:block; position:relative; padding:26px 50px 26px 0; border-bottom:1px solid #2c3e53; }
.brand-publication-list > a:hover h3 { color:#a1e9f8; }
.brand-paper-meta { display:flex; align-items:center; flex-wrap:wrap; gap:13px; font-size:11px; color:#b3c3d7; }
.brand-publication-list h3 { max-width:1000px; font-size:22px; line-height:1.35; letter-spacing:-.015em; margin:12px 0 8px; }
.brand-publication-list p { color:#acbfd5; font-size:13px; margin:0; }
.brand-paper-arrow { position:absolute; right:8px; top:50%; color:#91ddeb; font-size:25px; }
.brand-path-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:24px; }
.brand-path-grid > a { border:1px solid #324256; border-radius:4px; overflow:hidden; background:#0a1523; }
.brand-path-grid figure { margin:0; position:relative; }
.brand-path-grid img { display:block; width:100%; aspect-ratio:2.1; object-fit:cover; }
.brand-path-grid figcaption { position:absolute; bottom:8px; right:10px; background:#02070bd9; color:#cbd6e4; padding:4px 7px; font-size:10px; }
.brand-path-grid > a > div { padding:25px; }
.brand-path-grid h3 { font-size:26px; letter-spacing:-.025em; margin:12px 0; }
.brand-path-grid p { color:#b5c3d5; font-size:14px; line-height:1.65; }
.brand-more { margin-top:22px; }
.brand-collaboration { padding:72px 0; border-top:1px solid var(--line); background:linear-gradient(110deg,#102d42,#081521); }
.brand-collaboration .shell { display:flex; justify-content:space-between; align-items:center; gap:45px; }
.brand-collaboration h2 { font-size:clamp(29px,3.3vw,44px); letter-spacing:-.035em; line-height:1.16; margin:16px 0; }
.brand-collaboration p:not(.brand-kicker) { color:#bbcadc; max-width:570px; font-size:15px; line-height:1.6; }
.brand-collaboration .button { flex:none; }
@media(max-width:1000px) { .brand-hero-grid { grid-template-columns:minmax(0,1fr) 275px; gap:36px; } .brand-hero h1 { font-size:44px; } }
@media(max-width:760px) { .brand-hero { padding:35px 0; } .brand-hero-grid { grid-template-columns:minmax(0,1fr) 190px; gap:24px; } .brand-hero h1 { font-size:34px; } .brand-identity { font-size:19px; } .brand-lede { font-size:15px; } .brand-portrait figcaption { padding:30px 14px 14px; } .brand-portrait strong { font-size:12px; } .brand-domain-grid { grid-template-columns:1fr; gap:0; } .brand-section-heading { flex-direction:column; align-items:start; gap:20px; } .brand-section { padding:52px 0; } .brand-collaboration .shell { flex-direction:column; align-items:start; gap:20px; } }
@media(max-width:560px) { .brand-hero-grid { grid-template-columns:1fr; gap:28px; } .brand-hero h1 { font-size:36px; } .brand-portrait { width:min(100%,300px); justify-self:center; } .brand-portrait img { aspect-ratio:4/4.5; } .brand-section-label { align-items:start; flex-direction:column; gap:7px; } .brand-path-grid { grid-template-columns:1fr; } .brand-spotlight-grid { grid-template-columns:1fr; } .brand-publication-list h3 { font-size:19px; } }
@media(max-width:360px) { .brand-hero h1 { font-size:32px; } .brand-actions { flex-direction:column; } }
</style>
