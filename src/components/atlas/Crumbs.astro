---
interface Props { items:{name:string;href?:string}[] }
const {items}=Astro.props;
---
<nav class="atlas-crumbs" aria-label="Breadcrumb"><ol>{items.map((item,i)=><li>{item.href ? <a href={item.href}>{item.name}</a> : <span aria-current={i===items.length-1?'page':undefined}>{item.name}</span>}</li>)}</ol></nav>
