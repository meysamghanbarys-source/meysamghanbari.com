---
import type { upcoming } from '../data/library';
import EventImageCredit from './EventImageCredit.astro';
interface Props { item: (typeof upcoming)[number]; }
const { item } = Astro.props;
---
<article class="upcoming-feature event-card" id={item.slug}>
  <div class="event-destination">
    <a class="event-destination-heading" href={`/events/${item.slug}/`}><span>CONFERENCE DESTINATION</span><strong>{item.country}</strong><b>{item.city}</b></a>
    <figure class:list={['event-destination-visual', { 'conference-poster': item.imageKind === 'official-conference' }]}>
      <a href={`/events/${item.slug}/`} aria-label={`${item.shortName} in ${item.location}: presentation details`}><img src={item.image} srcset={item.imageSmall ? `${item.imageSmall} 640w, ${item.image} ${item.imageWidth}w` : undefined} sizes="(max-width: 900px) calc(100vw - 80px), 550px" alt={item.imageAlt} width={item.imageWidth} height={item.imageHeight} loading="lazy" /></a>
      <figcaption>{item.imageCaption}</figcaption>
    </figure>
    <EventImageCredit event={item} />
    <p class="event-destination-venue">{item.venue}</p>
  </div>
  <div class="event-presentation">
    <div class="event-status-line"><span class={`status-pill status-${item.status.toLowerCase()}`}>{item.status}</span><span>{item.date}</span></div>
    <h2><a href={`/events/${item.slug}/`}>{item.shortName}</a></h2>
    <p class="event-presenter"><span>{item.additionalPapers?.length ? 'TWO FORTHCOMING RESEARCH PRESENTATIONS' : item.status === 'Planned' ? 'PLANNED RESEARCH PRESENTATION' : 'FORTHCOMING RESEARCH PRESENTATION'}</span><strong>Meysam Ghanbari</strong></p>
    <div class="event-research-question"><p class="eyebrow">THE RESEARCH QUESTION</p><h3><a href={`${item.researchUrl}/`}>{item.question}</a></h3><p>{item.cardDescription}</p></div>
    <a class="event-paper-link" href={`${item.researchUrl}/`}>{item.paperTitle} →</a>
    {item.additionalPapers?.map(paper => <div class="event-additional"><p class="eyebrow">SECOND PRESENTATION</p><h3><a href={`${paper.researchUrl}/`}>{paper.question}</a></h3><p>{paper.cardDescription ?? paper.description}</p><a class="event-paper-link" href={`${paper.researchUrl}/`}>{paper.title} →</a></div>)}
    {item.presentationSlot && <p class="event-slot">Draft program · {item.presentationSlot}</p>}
    <div class="event-actions"><a class="button" href={`/events/${item.slug}/`}>Presentation details →</a><a class="button ghost" href={item.conferenceUrl} target="_blank" rel="noreferrer">Official conference ↗</a></div>
  </div>
</article>
<style>
.event-card { grid-template-columns:minmax(0,1fr) minmax(0,1fr); border-radius:5px 28px 5px 28px; scroll-margin-top:100px; }
.event-destination { min-width:0; padding:clamp(24px,3vw,40px); background:#0b1a2a; border-right:1px solid var(--line); }
.event-destination-heading { display:block; margin-bottom:24px; }
.event-destination-heading span { display:block; font-size:10px; font-weight:750; letter-spacing:.13em; color:#99c9dd; }
.event-destination-heading strong { display:block; margin:12px 0 5px; font-size:clamp(38px,4vw,56px); line-height:1.05; letter-spacing:-.04em; }
.event-destination-heading b { font-size:23px; font-weight:450; color:#bdd1e1; }
.event-destination-visual { margin:0; }
.event-destination-visual img { display:block; width:100%; height:auto; border-radius:4px; }
.event-destination-visual figcaption { margin-top:15px; color:#c2d1df; font-size:12px; line-height:1.7; }
.event-destination-venue { margin:22px 0 0; padding-top:18px; border-top:1px solid var(--line); color:#c2d1df; font-size:13px; line-height:1.7; }
.event-presentation { min-width:0; padding:clamp(24px,3vw,40px); }
.event-card .event-status-line { margin-bottom:23px; gap:10px 15px; }
.event-card h2 { font-size:clamp(25px,2.5vw,34px); line-height:1.2; letter-spacing:-.025em; margin:0 0 22px; }
.event-presenter { padding-bottom:24px; margin:0 0 24px; border-bottom:1px solid var(--line); }
.event-presenter span { display:block; color:#99c9dd; font-size:9px; font-weight:750; letter-spacing:.1em; line-height:1.6; }
.event-presenter strong { display:block; font-size:25px; line-height:1.3; margin-top:7px; }
.event-card h3 { font-size:21px; line-height:1.35; letter-spacing:-.015em; margin:0 0 12px; }
.event-card h2 a:hover,.event-card h3 a:hover,.event-paper-link:hover { color:var(--accent); }
.event-research-question .eyebrow,.event-additional .eyebrow { font-size:9px; margin:0 0 12px; }
.event-research-question > p:last-child,.event-additional > p:not(.eyebrow) { font-size:14px; line-height:1.75; color:#bdcfdf; margin:0 0 18px; }
.event-paper-link { display:block; color:#a0dfef; font-size:13px; line-height:1.65; }
.event-additional { border-top:1px solid var(--line); margin-top:24px; padding-top:24px; }
.event-slot { color:#a8ddea; font-size:12px; line-height:1.7; margin:22px 0 0; }
.status-planned { color:#f2d294; border-color:#cfa45e; background:#30271a; }
.event-card .event-actions { margin-top:26px; }
.event-card .event-actions .button { font-size:12px; padding-inline:15px; }
@media(max-width:900px) { .event-card { grid-template-columns:1fr; } .event-destination { border-right:0; border-bottom:1px solid var(--line); } .event-destination-heading strong { font-size:42px; } }
</style>
