---
import type { upcoming } from '../data/library';
interface Props { item: (typeof upcoming)[number]; }
const { item } = Astro.props;
---
<article class="upcoming-feature event-card" id={item.slug}>
  <div class="upcoming-feature-copy">
    <div class="event-status-line"><span class={`status-pill status-${item.status.toLowerCase()}`}>{item.status}</span><span>{item.date}</span><span>{item.location}</span></div>
    <p class="eyebrow">{item.shortName} · THE RESEARCH QUESTION</p>
    <h2><a href={`/events/${item.slug}/`}>{item.question}</a></h2>
    <p class="event-answer">{item.description}</p>
    {item.presentationSlot && <p class="event-slot">Draft program · {item.presentationSlot}</p>}
    <div class="event-paper"><span>PRESENTATION BY MEYSAM GHANBARI</span><h3><a href={`${item.researchUrl}/`}>{item.paperTitle}</a></h3></div>
    {item.additionalPapers?.map(paper => <div class="event-additional"><p class="eyebrow">SECOND PRESENTATION</p><h3><a href={`${paper.researchUrl}/`}>{paper.question}</a></h3><p>{paper.description}</p><a class="text-link" href={`${paper.researchUrl}/`}>{paper.title} →</a></div>)}
    <div class="tag-cloud event-tags">{item.tags.map(tag => <span>{tag}</span>)}</div>
    <div class="event-actions"><a class="button" href={`/events/${item.slug}/`}>Presentation details →</a><a class="button ghost" href={item.conferenceUrl} target="_blank" rel="noreferrer">Official conference ↗</a><a class="text-link" href={`${item.researchUrl}/`}>Read the research →</a></div>
  </div>
  <figure class="upcoming-feature-visual"><img src={item.image} alt={item.imageAlt} width={item.imageWidth} height={item.imageHeight} loading="lazy" /><figcaption><span>{item.shortName}</span><small>{item.type} · {item.venue}</small></figcaption></figure>
</article>
<style>
.event-card { grid-template-columns:minmax(0,1.12fr) minmax(0,.88fr); border-radius:5px 28px 5px 28px; }
.event-card .upcoming-feature-copy { padding:clamp(24px,3.2vw,44px); }
.event-card .event-status-line { margin-bottom:25px; gap:10px 15px; }
.event-card h2 { font-size:clamp(27px,2.7vw,38px); line-height:1.15; letter-spacing:-.025em; }
.event-card h2 a:hover { color:var(--accent); }
.event-card .event-paper h3 { font-size:19px; line-height:1.4; }
.event-card .event-answer { font-size:15px; line-height:1.75; }
.event-card .event-additional { border-top:1px solid var(--line); margin-top:25px; padding-top:24px; }
.event-card .event-additional h3 { font-size:23px; line-height:1.3; }
.event-card .event-additional p { font-size:14px; line-height:1.7; }
.event-card .event-additional .text-link { font-size:13px; line-height:1.7; }
.event-card .event-slot { color:#a8ddea; font-size:13px; line-height:1.7; }
.status-planned { color:#f2d294; border-color:#cfa45e; background:#30271a; }
.event-card .upcoming-feature-visual { display:flex; flex-direction:column; justify-content:center; min-height:0; padding:26px; background:#07111e; }
.event-card .upcoming-feature-visual::after { display:none; }
.event-card .upcoming-feature-visual img { width:100%; height:auto; min-height:0; object-fit:contain; border-radius:4px; }
.event-card .upcoming-feature-visual figcaption { position:static; margin-top:20px; }
.event-card .event-actions .button { font-size:12px; padding-inline:15px; }
@media(max-width:900px) { .event-card { grid-template-columns:1fr; } .event-card .upcoming-feature-visual { padding:24px; } }
</style>
