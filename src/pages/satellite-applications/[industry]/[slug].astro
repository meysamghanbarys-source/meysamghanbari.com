---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Copy from '../../../components/atlas/Copy.astro';
import Crumbs from '../../../components/atlas/Crumbs.astro';
import Picture from '../../../components/atlas/Picture.astro';
import {articles,related} from '../../../data/atlas/catalog';
import {industryById,industryUrl,articleUrl,root,familyId,dateLabel} from '../../../data/atlas/taxonomy';
import {site} from '../../../data/site';
import {serializeJsonLd} from '../../../data/json-ld';
import '../../../styles/atlas.css';
export function getStaticPaths(){return articles.map(a=>({params:{industry:a.industry,slug:a.slug},props:{a}}));}
const {a}=Astro.props, industry=industryById.get(a.industry)!, path=articleUrl(a);
const familyUrl=industryUrl(a.industry)+'#'+familyId(a.family);
const trail=[{name:'Satellite Applications Atlas',href:root},{name:industry.name,href:industryUrl(a.industry)},{name:a.family,href:familyUrl},{name:a.title,href:path}];
const contents=[['overview','At a glance'],['workflow','How it works'],['hardware','Hardware and data'],['orbits','Orbit comparison'],['costs','Implementation costs'],['markets','Countries and markets'],['providers','Missions and providers'],['limits','Operating limits'],['pilot','Designing a pilot'],['sources','Sources and credits']];
const recommendations=related(a);
const schema={'@context':'https://schema.org','@type':'TechArticle','@id':site.domain+path+'#article',headline:a.title,description:a.dek,inLanguage:'en',articleSection:industry.name,datePublished:a.published,dateModified:a.reviewed,isPartOf:{'@type':'CollectionPage',url:site.domain+root,name:'Satellite Applications Atlas'},mainEntityOfPage:site.domain+path,image:a.images.hero.files.at(-1)?site.domain+a.images.hero.files.at(-1)!.src:undefined,citation:a.sources.map(s=>s.url)};
---
<BaseLayout title={a.title} description={a.dek} path={path} image={a.images.hero.files.at(-1)!.src} imageAlt={a.images.hero.alt} ogType="article" breadcrumbTrail={trail}>
 <script slot="head" type="application/ld+json" set:html={serializeJsonLd(schema)}></script>
 <article class="atlas atlas-article"><header class="atlas-article-hero"><div class="shell"><Crumbs items={trail.slice(0,3)}/><div class="atlas-article-grid"><div><h1>{a.title}</h1><p class="atlas-dek">{a.dek}</p><p class="atlas-date">Published <time datetime={a.published}>{dateLabel(a.published)}</time> · Reviewed <time datetime={a.reviewed}>{dateLabel(a.reviewed)}</time></p><a class="atlas-text-link" href="#costs">Jump to implementation costs ↓</a></div><Picture image={a.images.hero} eager /></div></div></header>
 <div class="shell atlas-reading"><aside class="atlas-rail"><nav aria-label="On this page"><strong>On this page</strong>{contents.map(([id,name])=><a href={'#'+id}>{name}</a>)}</nav></aside>
 <div class="atlas-body"><details class="atlas-mobile-toc"><summary>On this page <span aria-hidden="true">⌄</span></summary><nav aria-label="Article sections">{contents.map(([id,name])=><a href={'#'+id}>{name}</a>)}</nav></details>
 <section id="overview"><h2>Application at a glance</h2><dl class="atlas-glance">{a.glance.map(g=><div><dt>{g.label}</dt><dd><Copy value={g.value}/></dd></div>)}</dl><h3>The operating decision</h3>{a.problem.map(p=><p><Copy value={p}/></p>)}</section>
 <section id="workflow"><h2>How it works</h2><ol class="atlas-workflow">{a.workflow.map(s=><li><h3>{s.title}</h3><p><Copy value={s.text}/></p></li>)}</ol>{a.imageComparison ? <div class="atlas-observations"><div><h3>{a.imageComparison[0]}</h3><Picture image={a.images.hero}/></div><div><h3>{a.imageComparison[1]}</h3><Picture image={a.images.evidence}/></div></div> : <Picture image={a.images.evidence}/>}</section>
 <section id="hardware"><h2>Hardware and ground processing</h2><div class:list={{"atlas-hardware":!!a.images.hardware}}><div class="atlas-facts">{a.hardware.map(s=><div><h3>{s.title}</h3><p><Copy value={s.text}/></p></div>)}</div>{a.images.hardware && <Picture image={a.images.hardware}/>}</div></section>
 <section id="orbits"><h2>Which orbit fits?</h2><div class="atlas-orbit-table" role="table" aria-label="Orbit feasibility by operating need"><div class="atlas-orbit-head" role="row"><span role="columnheader">Orbit & fit</span><span role="columnheader">Geometry & observation</span><span role="columnheader">Operating decision</span></div>{a.orbitsCompared.map(o=><div role="row" class="atlas-orbit-row"><div role="rowheader"><strong>{o.orbit}</strong><span class="atlas-status">{o.status}</span></div><div role="cell"><p><Copy value={o.geometry}/></p><p><Copy value={o.performance}/></p></div><div role="cell"><p><Copy value={o.decision}/></p></div></div>)}</div><a class="atlas-text-link" href={root+'orbits/'}>Compare orbit fundamentals →</a></section>
 <section id="costs"><h2>What would it cost?</h2><p>Each figure has its own scope, currency basis and pricing date. The comparisons below distinguish data purchases, instrument hosting and spacecraft ownership.</p><div class="atlas-costs">{a.costs.map(c=><div><div class="atlas-cost-title"><span class="atlas-label">{c.model}</span><h3>{c.headline}</h3><span class="atlas-unit">{c.unit}</span></div><p><Copy value={c.detail}/></p></div>)}</div></section>
 <section id="markets"><h2>Countries and markets</h2><figure class="atlas-map"><svg viewBox="0 0 720 360" role="img" aria-label={'Illustrative operating regions: '+a.markets.map(m=>m.country).join(', ')}><image href="/images/atlas/world-land.svg" width="720" height="360"/>{a.markets.map((m,i)=><g transform={'translate('+((m.longitude+180)*2)+' '+((90-m.latitude)*2)+')'}><circle r="10" fill="#aaf0dc" stroke="#082029" stroke-width="2"/><text y="3.7" text-anchor="middle" font-size="11" font-weight="700" fill="#09232f">{i+1}</text></g>)}</svg><figcaption>Numbered points mark illustrative operating regions. Map data from <a href="https://www.naturalearthdata.com/about/terms-of-use/">Natural Earth</a>.</figcaption></figure><ol class="atlas-markets">{a.markets.map(m=><li><h3>{m.country}</h3><p><Copy value={m.reason}/></p></li>)}</ol></section>
 <section id="providers"><h2>Real missions and providers</h2><div class="atlas-facts">{a.providers.map(p=><div><span class="atlas-label">{p.status}</span><h3>{p.name}</h3><p><Copy value={p.text}/></p></div>)}</div></section>
 <section id="limits"><h2>Operating limits</h2><div class="atlas-facts">{a.limits.map(s=><div><h3>{s.title}</h3><p><Copy value={s.text}/></p></div>)}</div></section>
 <section id="pilot"><h2>Designing a first pilot</h2><ol class="atlas-pilot">{a.pilot.map(s=><li><h3>{s.title}</h3><p><Copy value={s.text}/></p></li>)}</ol><div class="atlas-decision"><h3>When it makes business sense</h3>{a.conclusion.map(p=><p><Copy value={p}/></p>)}<a class="atlas-primary" href="/contact/">Discuss a satellite application ↗</a></div></section>
 <section id="sources"><h2>Sources and credits</h2><p class="atlas-fine">Technical and price references checked <time datetime={a.reviewed}>{dateLabel(a.reviewed)}</time>. Image credits are given with each observation.</p><ol class="atlas-sources">{a.sources.map(s=><li id={'source-'+s.id} value={s.id}><a href={s.url}>{s.title}</a><span>{s.publisher} · {s.date}</span></li>)}</ol></section>
 <nav class="atlas-related" aria-label="Related reading"><h2>Continue exploring</h2>{recommendations.map(r=><a href={articleUrl(r)}>{r.title} →</a>)}<a href={industryUrl(a.industry)}>{industry.name} applications →</a><a href={root}>All satellite applications →</a></nav></div></div></article></BaseLayout>
