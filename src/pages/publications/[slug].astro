---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { publications } from '../../data/library';
import { projects } from '../../data/library';
import { site } from '../../data/site';

export function getStaticPaths() {
  return publications.map((paper) => ({ params: { slug: paper.slug }, props: { paper } }));
}

const { paper } = Astro.props;
const path = `/publications/${paper.slug}`;
const relatedProjects = projects.en.filter((project) => paper.relatedProjectSlugs?.includes(project.slug));
const relatedPapers = publications
  .filter((candidate) => candidate.slug !== paper.slug && candidate.tags.some((tag) => paper.tags.includes(tag)))
  .slice(0, 3);
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'ScholarlyArticle',
  headline: paper.title,
  author: paper.authors.split(/,\s*(?:and\s+)?/).map((name) => ({ '@type': 'Person', name })),
  datePublished: paper.status === 'Published' ? paper.year : undefined,
  publisher: paper.venue,
  url: `${site.domain}${path}`,
  about: paper.tags,
  sameAs: paper.doi || paper.externalUrl,
  isPartOf: { '@type': 'WebSite', '@id': `${site.domain}/#website` }
};
---

<BaseLayout title={paper.title} description={paper.summaryEn} lang="en" path={path}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(articleSchema)}></script>
  <section class="paper-hero paper-hero-product">
    <div class="space-grid-bg" aria-hidden="true"></div>
    <div class="shell paper-shell">
      <a class="back-link" href="/publications">← Publications</a>
      <div class="paper-meta-line">
        <span>{paper.type}</span><span>{paper.year}</span><span class={`status-pill status-${paper.status.toLowerCase()}`}>{paper.status}</span>
      </div>
      <h1>{paper.title}</h1>
      <p class="paper-authors">{paper.authors}</p>
      <p class="paper-venue">{paper.venue}</p>
      <div class="paper-actions">
        {paper.doi && <a class="button" href={paper.doi} target="_blank" rel="noreferrer">DOI</a>}
        {paper.pdf && <a class="button ghost" href={paper.pdf} target="_blank" rel="noreferrer">PDF</a>}
        {paper.video && <a class="button ghost" href={paper.video} target="_blank" rel="noreferrer">Video</a>}
        {paper.externalUrl && <a class="button ghost" href={paper.externalUrl} target="_blank" rel="noreferrer">Publisher record</a>}
      </div>
      <div class="paper-signal-line" aria-label="Research topics">{paper.tags.map((tag) => <span>{tag}</span>)}</div>
    </div>
  </section>

  <section class="section paper-body-section">
    <div class="shell paper-content-grid">
      <article class="paper-main">
        <p class="eyebrow">PUBLICATION HERO</p>
        <h2>Research overview</h2>
        <p class="paper-summary">{paper.summaryEn}</p>

        <h2>Research problem</h2>
        <p>{paper.problemEn ?? `This publication addresses a research problem within ${paper.tags.slice(0, 3).join(', ')}. The website summary is intentionally limited to the verified publication record.`}</p>

        <h2>Core idea</h2>
        <p>{paper.ideaEn ?? paper.summaryEn}</p>

        <div class="paper-architecture-block">
          <p class="eyebrow">SYSTEM / ARCHITECTURE</p>
          <div>{paper.tags.map((tag, index) => <span><small>0{index + 1}</small><strong>{tag}</strong></span>)}</div>
        </div>

        <h2>Why it matters</h2>
        <p>{paper.relevanceEn ?? 'The publication contributes to a wider research program in advanced optical, satellite, quantum or intelligent communication systems. Engineering claims are kept within the scope of the verified record.'}</p>

        <div class="evidence-note"><strong>Results & evidence</strong><p>Numerical claims and detailed results are not reproduced here unless they are available in the verified public paper. Use the publisher, DOI or PDF link above when available for the complete technical record.</p></div>

        <h2>Publication record</h2>
        <dl class="paper-record">
          <div><dt>Authors</dt><dd>{paper.authors}</dd></div>
          <div><dt>Venue</dt><dd>{paper.venue}</dd></div>
          <div><dt>Year</dt><dd>{paper.year}</dd></div>
          <div><dt>Status</dt><dd>{paper.status}</dd></div>
        </dl>

        {relatedProjects.length > 0 && <><h2>Related projects</h2><div class="related-records">{relatedProjects.map((project) => <a href={project.href}><span>{project.number} · {project.category}</span><strong>{project.title}</strong><small>Explore project ↗</small></a>)}</div></>}

        {relatedPapers.length > 0 && <><h2>Related research</h2><div class="related-records">{relatedPapers.map((related) => <a href={`/publications/${related.slug}`}><span>{related.year} · {related.status}</span><strong>{related.title}</strong><small>{related.venue} ↗</small></a>)}</div></>}
      </article>

      <aside class="paper-sidebar">
        <div class="side-card">
          <p class="eyebrow">KEYWORDS</p>
          <div class="tag-cloud">{paper.tags.map((tag) => <span>{tag}</span>)}</div>
        </div>
        <div class="side-card">
          <p class="eyebrow">RELATED ENQUIRIES</p>
          <p>For technical discussion, research collaboration or a related industrial R&D problem, contact Meysam Ghanbari.</p>
          <a class="text-link" href="/contact">Discuss this research →</a>
        </div>
        <div class="side-card"><p class="eyebrow">BEHIND THE RESEARCH</p><p>This page is an original editorial explanation of the public research record. It does not replace the peer-reviewed or submitted manuscript.</p></div>
      </aside>
    </div>
  </section>
</BaseLayout>
