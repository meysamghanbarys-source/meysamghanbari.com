---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { upcoming } from '../../data/library';
import { eventSchema } from '../../data/event-schema';
import { serializeJsonLd } from '../../data/json-ld';
export function getStaticPaths() {
  return upcoming.map(event => ({ params:{slug:event.slug}, props:{event} }));
}
const { event } = Astro.props;
---
<BaseLayout title={event.title} description={event.description} path={`/events/${event.slug}/`} image={event.image} imageAlt={event.imageAlt}>
  <script slot="head" type="application/ld+json" set:html={serializeJsonLd(eventSchema(event))}></script>
  <section class="appearance-header"><div class="shell">
    <a class="appearance-back" href="/upcoming/">← Upcoming appearances</a>
    <p class="eyebrow">{event.status} · {event.shortName} · {event.location}</p>
    <h1>{event.title}</h1>
    <p class="appearance-date">{event.date} · {event.venue}</p>
  </div></section>
  <div class="shell appearance-body">
    <article>
      <section class="appearance-question"><p class="eyebrow">THE RESEARCH QUESTION</p><h2>{event.question}</h2><p>{event.description}</p></section>
      <figure><img src={event.image} alt={event.imageAlt} width={event.imageWidth} height={event.imageHeight} loading="lazy" /><figcaption>{event.paperLinkLabel ? 'Concept illustration for the research presentation; the formal model and numerical evidence are explained on the publication page.' : event.imageAlt}</figcaption></figure>
      <section><h2>Presentation paper</h2><h3><a href={`${event.researchUrl}/`}>{event.paperTitle}</a></h3><p>Meysam Ghanbari is the planned presenter of this coauthored research. The publication page provides the complete author list, original abstract, method, results and limitations.</p><a class="button" href={`${event.researchUrl}/`}>Read the research →</a></section>
      {event.programNote && <section><h2>Program and schedule</h2>{event.presentationSlot && <p class="appearance-slot">{event.presentationSlot}</p>}<p>{event.programNote}</p>{event.programUrl && <a class="button ghost" href={event.programUrl} target="_blank" rel="noreferrer">Official draft program ↗</a>}</section>}
      <section><h2>Discuss the engineering</h2><p>For research discussion, industrial R&D collaboration or a related speaking invitation, contact Meysam Ghanbari.</p><a class="text-link" href="/contact/">Start a conversation →</a></section>
    </article>
    <aside><h2>Event details</h2><dl><dt>Conference</dt><dd>{event.conference}</dd><dt>Conference dates</dt><dd>{event.date}</dd><dt>Venue</dt><dd>{event.venue}</dd><dt>Location</dt><dd>{event.location}</dd><dt>Presenter</dt><dd>Meysam Ghanbari</dd><dt>Presentation</dt><dd>{event.type}</dd></dl><a class="button ghost" href={event.conferenceUrl} target="_blank" rel="noreferrer">Official conference ↗</a>{event.projectUrl && <a class="appearance-project" href={`${event.projectUrl}/`}>Related project →</a>}</aside>
  </div>
</BaseLayout>
<style>
.appearance-header { padding:35px 0 45px; background:radial-gradient(ellipse at 90% 0,#12364c70,transparent 65%),#07111e; border-bottom:1px solid var(--line); }
.appearance-back { display:inline-flex; min-height:44px; align-items:center; color:#aac6dc; font-size:13px; margin-bottom:20px; }
.appearance-header h1 { font-size:clamp(33px,4vw,53px); line-height:1.15; letter-spacing:-.035em; margin:15px 0; }
.appearance-date { color:#b9cfdf; font-size:15px; line-height:1.7; }
.appearance-body { --shell:1080px; display:grid; grid-template-columns:minmax(0,740px) minmax(0,260px); gap:60px; padding-block:45px 70px; }
.appearance-body article > section { margin-bottom:40px; }
.appearance-body h2 { font-size:27px; line-height:1.3; margin:0 0 18px; letter-spacing:-.02em; }
.appearance-body h3 { font-size:21px; line-height:1.5; margin:0 0 18px; }
.appearance-body p { font-size:16px; line-height:1.8; color:#c1d2e1; }
.appearance-question { border-left:3px solid #82dff4; padding:25px; background:#0c1c2d; }
.appearance-question .eyebrow { font-size:10px; color:#87dff4; }
.appearance-body figure { margin:0 0 40px; }
.appearance-body img { width:100%; height:auto; border-radius:4px; }
.appearance-body figcaption { color:#a5b9cf; font-size:12px; margin-top:12px; line-height:1.7; }
.appearance-body .appearance-slot { color:#9fe5f3; }
.appearance-body aside { border-top:1px solid var(--line); padding-top:24px; align-self:start; }
.appearance-body aside h2 { font-size:17px; }
.appearance-body dt { color:#96b5ce; font-size:11px; text-transform:uppercase; letter-spacing:.08em; }
.appearance-body dd { margin:8px 0 24px; font-size:14px; line-height:1.7; overflow-wrap:anywhere; }
.appearance-body aside .button { font-size:12px; }
.appearance-project { display:block; padding-top:20px; color:#9ee1f1; }
@media(max-width:750px) { .appearance-body { grid-template-columns:1fr; gap:25px; } .appearance-question { padding:20px; } }
</style>
