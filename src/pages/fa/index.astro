
---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';
import { publications } from '../../data/library';
import { insightsFa } from '../../data/insights-fa';

const c = site.home.fa;
const featured = publications.slice(0, 4);
---

<BaseLayout
  title={site.name}
  description="وب‌سایت رسمی پژوهشی میثم قنبری در حوزه مخابرات نوری، ماهواره‌ای و سامانه‌های ارتباطی پیشرفته."
  lang="fa"
  path="/fa/"
  image={site.heroImage}
>
  <section class="hero hero-space hero-space-clean">
    <div class="hero-space-bg" style={`background-image:url('${site.heroImage}')`}></div>
    <div class="hero-space-overlay"></div>
    <div class="orbit-lines orbit-lines-animated" aria-hidden="true"></div>
    <div class="hero-stars" aria-hidden="true"></div>
    <div class="hero-planet hero-planet-main" aria-hidden="true"></div>
    <div class="shell hero-grid hero-grid-space hero-grid-clean">
      <div class="hero-copy hero-copy-clean">
        <p class="eyebrow">{c.eyebrow}</p>
        <h1>{site.name}</h1>
        <p class="role">{site.role.fa}</p>
        <h2>{c.headline}</h2>
        <p class="lede lede-compact">{c.intro}</p>
        <div class="hero-actions">
          <a class="button" href="/fa/research">پژوهش</a>
          <a class="button ghost" href="/fa/publications">مقالات</a>
          <a class="button ghost" href="/fa/contact">ارتباط</a>
        </div>
        <div class="signal-row" aria-label="محورهای پژوهشی">
          <span>OISL</span><span>FSO</span><span>Receiver Systems</span><span>PAT</span><span>Quantum</span>
        </div>
      </div>

      <div class="hero-profile-card hero-profile-card-clean">
        <img
          src="/images/profile/meysam-ghanbari-formal-portrait.webp"
          alt="پرتره رسمی میثم قنبری"
          loading="eager"
          fetchpriority="high"
        />
        <div class="hero-profile-caption">
          <span>MEYSAM GHANBARI</span>
          <small>Optical · Satellite · Deep-Tech Communications</small>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-home-panels">
    <div class="shell home-panels-grid">
      <a class="home-panel home-panel-research" href="/fa/research">
        <span class="tag">پژوهش</span>
        <h3>سامانه‌های نوری و ماهواره‌ای</h3>
        <p>معماری گیرنده، OISL، FSO، رهگیری و شبکه‌های غیرزمینی.</p>
      </a>
      <a class="home-panel home-panel-publications" href="/fa/publications">
        <span class="tag">مقالات</span>
        <h3>مقالات ژورنالی و کنفرانسی</h3>
        <p>کتابخانه‌ای ساختاریافته از مقالات با صفحات اختصاصی و توضیح کوتاه.</p>
      </a>
      <a class="home-panel home-panel-insights" href="/fa/insights">
        <span class="tag">دیدگاه‌ها</span>
        <h3>نگاه فنی به آینده</h3>
        <p>ایده‌ها و جهت‌گیری‌ها در مخابرات پیشرفته، فوتونیک، فضا و دیپ‌تک.</p>
      </a>
    </div>
  </section>

  <section class="section section-muted">
    <div class="shell">
      <div class="section-heading split-heading">
        <div>
          <p class="eyebrow">مقالات منتخب</p>
          <h2>نمونه آثار</h2>
        </div>
        <p>منتخبی از پژوهش‌ها در حوزه لینک‌های نوری، سامانه‌های هوشمند مخابراتی و ارتباطات ماهواره‌ای.</p>
      </div>
      <div class="publication-list">
        {featured.map((paper) => (
          <a class="publication-row publication-link" href={`/fa/publications/${paper.slug}`}>
            <div>
              <p class="tag">{paper.type} · {paper.year} · {paper.status}</p>
              <h3>{paper.title}</h3>
              <p>{paper.venue}</p>
            </div>
            <span class="publication-arrow">↗</span>
          </a>
        ))}
      </div>
      <a class="text-link large-link" href="/fa/publications">مشاهده کتابخانه مقالات ←</a>
    </div>
  </section>

  <section class="section home-future-systems">
    <div class="shell">
      <div class="home-future-header">
        <div><p class="eyebrow">FUTURE SYSTEMS · دیدگاه‌ها</p><h2>یک نظام فکری برای اندیشیدن فراتر از چرخهٔ بعدی فناوری.</h2></div>
        <p>جستارهای میثم قنبری دربارهٔ حکمرانی هوش مصنوعی، ابرهوش، نهادهای بلندمدت، ارتقای انسان و آیندهٔ تمدن.</p>
      </div>
      <div class="home-future-grid">
        {insightsFa.slice(0, 3).map((item, index) => (
          <a class={`home-future-card theme-${item.theme}`} href={`/fa/insights/${item.slug}`}>
            <img src={index === 0 ? item.portrait : item.conceptImage} alt={index === 0 ? item.portraitAlt : item.conceptAlt} width="1200" height="675" loading="lazy" />
            <div><span>دیدگاه {item.number}</span><h3>{item.cardTitle}</h3><p>{item.excerpt}</p><b>مطالعه در Future Systems ←</b></div>
          </a>
        ))}
      </div>
      <div class="home-future-action"><a class="button" href="/fa/insights">ورود به Future Systems</a><a class="text-link" href="/fa/insights/intelligence-governance">هوش، حکمرانی و تمدن ←</a></div>
    </div>
  </section>

  <section class="section section-collaboration">
    <div class="shell collaboration-card">
      <div>
        <p class="eyebrow">ارتباط</p>
        <h2>همکاری پژوهشی، مشاوره و دعوت به سخنرانی</h2>
        <p>برای همکاری، گفت‌وگوی فنی، مشاوره، دعوت به سخنرانی و فرصت‌های صنعتی از صفحه ارتباط استفاده شود.</p>
      </div>
      <a class="button light" href="/fa/contact">ارتباط</a>
    </div>
  </section>
</BaseLayout>
