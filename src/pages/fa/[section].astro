---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sectionIds, site } from '../../data/site';
import { projects, publications, videos, insights, upcoming, media } from '../../data/library';

export function getStaticPaths() {
  return sectionIds.filter((section) => section !== 'insights').map((section) => ({ params: { section }, props: { section } }));
}

const { section } = Astro.props;
const data = site.sections.fa[section];
const path = `/fa/${section}`;
const journals = publications.filter((p) => p.type === 'Journal');
const conferences = publications.filter((p) => p.type === 'Conference');
const upcomingEvent = upcoming[0];

const sectionVisuals = {
  research: { image: '/images/profile/meysam-ghanbari-space-communications-researcher.webp', label: 'حوزه پژوهشی' },
  projects: { image: '/images/profile/meysam-ghanbari-satellite-optical-communications.webp', label: 'مسیرهای مهندسی' },
  publications: { image: '/images/profile/meysam-ghanbari-space-communications-researcher.webp', label: 'کتابخانه مقالات' },
  videos: { image: '/images/media/meysam-ghanbari-research-presentation.webp', label: 'ارائه‌ها و سخنرانی‌ها' },
  insights: { image: '/images/profile/meysam-ghanbari-satellite-optical-communications.webp', label: 'دیدگاه‌های فنی' },
  upcoming: { image: upcomingEvent?.image ?? '/images/media/meysam-ghanbari-research-presentation.webp', label: 'IEEE VTC 2027-Spring · هامبورگ' },
  media: { image: '/images/profile/meysam-ghanbari-formal-portrait.webp', label: 'آرشیو رسانه' },
  about: { image: '/images/profile/meysam-ghanbari-professional-headshot.webp', label: 'پروفایل پژوهشی' },
  contact: { image: '/images/media/meysam-ghanbari-research-workspace.webp', label: 'ارتباط پژوهشی' }
} as const;

const visual = sectionVisuals[section];
---

<BaseLayout
  title={data.title}
  description={section === 'upcoming' && upcomingEvent ? 'میثم قنبری در IEEE VTC 2027-Spring در هامبورگ پژوهش خود درباره گیرنده نوری چندشاخه برای لینک‌های بین HAPS را ارائه خواهد کرد.' : data.intro}
  lang="fa"
  path={path}
  image={section === 'upcoming' && upcomingEvent ? upcomingEvent.image : undefined}
  imageAlt={section === 'upcoming' && upcomingEvent ? upcomingEvent.imageAlt : undefined}
>
  
<section class={`page-hero page-hero-space page-hero-${section}`}>
  <div class="space-grid-bg" aria-hidden="true"></div>
  <div class="page-hero-backdrop" style={`background-image:url('${visual.image}')`}></div>
  <div class="page-hero-orbit" aria-hidden="true"></div>
  <div class="shell page-hero-shell">
    <div class="page-hero-copy narrow">
      <p class="eyebrow">{data.kicker}</p>
      <h1>{data.title}</h1>
      <p class="page-intro">{data.intro}</p>
    </div>
    <div class="page-hero-sidecard">
      <img src={visual.image} alt={visual.label} loading="eager" />
      <div>
        <span>{visual.label}</span>
        <small>{site.name}</small>
      </div>
    </div>
  </div>
</section>

  {section === 'research' && (
    <section class="section section-tight">
      <div class="shell">
        <a class="research-record-feature" href="/fa/research/optical-communications-records/">
          <div class="research-record-copy">
            <span>جدید · رصدخانه فنی</span>
            <h2>رصدخانه رکوردهای مخابرات نوری و ماهواره‌ای</h2>
            <p>رکوردهای تأییدشدهٔ سرعت، برد، رهگیری، رله، لینک‌های کوانتومی و انتقال توان نوری را همراه با روش مهندسی، پروژه و منبع اولیه بررسی کنید.</p>
            <div dir="ltr"><strong>200 Gbit/s</strong><strong>460M km</strong><strong>30 ps</strong><strong>&gt;800 W</strong></div>
            <b>ورود به رصدخانه رکوردها ←</b>
          </div>
          <img src="/images/records/optical-record-observatory.svg" alt="نقشه رکوردهای مخابرات نوری و ماهواره‌ای در مدار زمین و اعماق فضا" width="1600" height="900" loading="eager" />
        </a>
        <div class="card-grid research-grid">
          {site.themes.fa.map(([title, text], i) => (
            <article class="card research-card">
              <span class="card-index">0{i + 1}</span>
              <h2>{title}</h2>
              <p>{text}</p>
            </article>
          ))}
        </div>
        <div class="expertise-panel">
          <div>
            <p class="eyebrow">پروفایل فنی</p>
            <h2>مدل‌سازی تحلیلی، طراحی گیرنده و پیاده‌سازی سامانه‌های مخابراتی</h2>
          </div>
          <div class="expertise-list" dir="ltr">
            <span>Link budgets & Gaussian-beam propagation</span>
            <span>Receiver noise & sensitivity</span>
            <span>Photodetector / TIA interfaces</span>
            <span>Pointing error & jitter</span>
            <span>Acquisition, alignment & fine tracking</span>
            <span>BER / SER / outage modeling</span>
            <span>Monte Carlo simulation & optimization</span>
            <span>MATLAB · Python · C · FPGA</span>
          </div>
        </div>
      </div>
    </section>
  )}

  {section === 'projects' && (
    <section class="section section-tight">
      <div class="shell">
        <div class="card-grid two project-detail-grid">
          {projects.fa.map((project, i) => (
            <article class="card project-card project-card-large">
              <span class="card-index">0{i + 1}</span>
              <p class="tag">{project.tag}</p>
              <h2>{project.title}</h2>
              <p>{project.summary}</p>
              <div class="project-meta"><span>Architecture</span><span>Analysis</span><span>Simulation</span><span>Publication</span></div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  {section === 'publications' && (
    <section class="section section-tight">
      <div class="shell" dir="ltr">
        <div class="publication-group">
          <div class="group-heading"><span>JOURNALS</span><strong>{journals.length}</strong></div>
          <div class="publication-list">
            {journals.map((paper) => (
              <a class="publication-row publication-link" href={`/fa/publications/${paper.slug}`}>
                <div><p class="tag">{paper.year} · {paper.status}</p><h2>{paper.title}</h2><p>{paper.authors}</p><p>{paper.venue}</p></div>
                <span class="publication-arrow">↗</span>
              </a>
            ))}
          </div>
        </div>
        <div class="publication-group">
          <div class="group-heading"><span>CONFERENCES</span><strong>{conferences.length}</strong></div>
          <div class="publication-list">
            {conferences.map((paper) => (
              <a class="publication-row publication-link" href={`/fa/publications/${paper.slug}`}>
                <div><p class="tag">{paper.year} · {paper.status}</p><h2>{paper.title}</h2><p>{paper.authors}</p><p>{paper.venue}</p></div>
                <span class="publication-arrow">↗</span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>
  )}

  {section === 'videos' && (
    <section class="section section-tight"><div class="shell">
      {videos.length === 0 ? <div class="empty-state"><span class="empty-icon">▶</span><h2>ویدئوی عمومی ثبت نشده است</h2><p>ارائه‌های پژوهشی و محتوای فنی عمومی در این بخش نمایش داده خواهند شد.</p></div> : null}
    </div></section>
  )}

  {section === 'insights' && (
    <section class="section section-tight"><div class="shell">
      {insights.length === 0 ? <div class="empty-state insight-empty"><span class="empty-icon">✦</span><h2>دیدگاه‌ها</h2><p>هنوز دیدگاه فنی عمومی در این بخش منتشر نشده است.</p></div> : null}
    </div></section>
  )}

  {section === 'upcoming' && (
    <section class="section section-tight"><div class="shell">
      {upcoming.length === 0 ? (
        <div class="upcoming-empty"><div class="upcoming-orbit" aria-hidden="true"></div><p class="eyebrow">تقویم</p><h2>در حال حاضر رویداد عمومی پیش‌رو ثبت نشده است.</h2><p>برای دعوت، بازدید پژوهشی یا درخواست سخنرانی از صفحه ارتباط استفاده شود.</p><a class="button ghost" href="/fa/contact">ارسال دعوت</a></div>
      ) : (
        <div class="upcoming-list">
          {upcoming.map((item) => (
            <article class="upcoming-feature">
              <div class="upcoming-feature-copy">
                <div class="event-status-line"><span class="status-pill status-scheduled">برنامه‌ریزی‌شده</span><span>{item.date}</span><span>{item.locationFa}</span></div>
                <p class="eyebrow">سؤال پژوهشی</p>
                <h2>{item.questionFa}</h2>
                <p class="event-answer">{item.descriptionFa}</p>
                <div class="event-paper"><span>مقاله ارائه</span><h3><a href={item.paperUrl} target="_blank" rel="noreferrer">{item.paperTitle}</a></h3></div>
                <div class="tag-cloud event-tags">{item.tags.map((tag) => <span>{tag}</span>)}</div>
                <div class="event-actions"><a class="button" href={item.conferenceUrl} target="_blank" rel="noreferrer">وب‌سایت رسمی کنفرانس ↗</a><a class="button ghost" href={item.paperUrl} target="_blank" rel="noreferrer">Google Scholar ↗</a><a class="text-link" href={`/fa${item.researchUrl}`}>مشاهده پژوهش ←</a></div>
              </div>
              <figure class="upcoming-feature-visual"><img src={item.image} alt={item.imageAlt} width="1280" height="720" loading="eager" /><figcaption><span>{item.conference}</span><small>{item.typeFa} · {item.venue}</small></figcaption></figure>
            </article>
          ))}
        </div>
      )}
    </div></section>
  )}

  {section === 'media' && (
    <section class="section section-tight"><div class="shell"><div class="media-grid-v2">
      {media.map((item, i) => <figure class={`media-card media-card-${i + 1}`}><img src={item.src} alt={item.alt} loading={i < 2 ? 'eager' : 'lazy'} /><figcaption>{item.labelFa}</figcaption></figure>)}
    </div></div></section>
  )}

  {section === 'about' && (
    <section class="section section-tight"><div class="shell about-grid about-grid-v2">
      <div class="about-visual"><img class="about-portrait" src="/images/profile/meysam-ghanbari-satellite-optical-communications.webp" alt="میثم قنبری در محیط پژوهشی ماهواره و مخابرات نوری" /></div>
      <div class="prose">
        <p class="eyebrow">پروفایل</p><h2>سامانه‌های مخابرات نوری، ماهواره‌ای و پیشرفته</h2>
        <p>میثم قنبری پژوهشگر و مهندسی در حوزه مخابرات ماهواره‌ای و نوری است و فعالیت فنی او لینک‌های نوری بین‌ماهواره‌ای، FSO، طراحی گیرنده و TIA و مسائل pointing، acquisition و tracking را پوشش می‌دهد.</p>
        <p>کار فنی او شامل مدل‌سازی تحلیلی و مونت‌کارلو برای بودجه لینک، نویز گیرنده، انتشار پرتو، هم‌ترازی، BER/SER و outage و همچنین FPGA، MATLAB/Python/C، دوقلوهای دیجیتال فیزیک‌محور و اتوماسیون صنعتی است.</p>
        <h2>تمرکز پژوهشی</h2><ul><li>لینک‌های نوری بین‌ماهواره‌ای</li><li>سامانه‌های FSO و شبکه‌های غیرزمینی</li><li>معماری گیرنده و حساسیت</li><li>PAT و رهگیری دقیق</li><li>لینک‌های کوانتومی</li><li>مدل‌سازی تحلیلی، مونت‌کارلو و دوقلوهای دیجیتال</li></ul>
        <div class="about-actions"><a class="button" href="/fa/publications">کتابخانه مقالات</a><a class="button ghost" href="/fa/contact">ارتباط پژوهشی</a></div>
      </div>
    </div></section>
  )}

  {section === 'contact' && (
    <section class="section section-tight"><div class="shell contact-grid">
      <a class="contact-card" href={`mailto:${site.contactEmail}`}><span class="tag">ایمیل مستقیم</span><h2 dir="ltr">{site.contactEmail}</h2><p>برای همکاری پژوهشی، تحقیق‌وتوسعه صنعتی، مشاوره فنی، سخنرانی، رسانه و فرصت‌های دیپ‌تک.</p><span class="text-link">ارسال ایمیل ←</span></a>
      <div class="contact-card contact-photo-card"><img src="/images/media/meysam-ghanbari-research-workspace.webp" alt="میثم قنبری در محیط کار پژوهشی" loading="lazy" /><div class="contact-photo-copy"><span class="tag">انواع درخواست</span><p>Research collaboration · Industry R&D · Technical consulting · Speaking · Media · Deep-tech</p></div></div>
    </div></section>
  )}
</BaseLayout>
