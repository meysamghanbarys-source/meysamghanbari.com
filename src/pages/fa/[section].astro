---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sectionIds, site } from '../../data/site';
import { projects, publications, videos, insights, upcoming, media } from '../../data/library';
import { researchDomainLinks } from '../../data/research-domains';

export function getStaticPaths() {
  return sectionIds.filter((section) => section !== 'insights').map((section) => ({ params: { section }, props: { section } }));
}

const { section } = Astro.props;
const data = site.sections.fa[section];
const path = `/fa/${section}`;
const journals = publications.filter((p) => p.type === 'Journal');
const conferences = publications.filter((p) => p.type === 'Conference');
const upcomingEvent = upcoming[0];
const statusFa = { Published: 'منتشرشده', Accepted: 'پذیرفته‌شده', Submitted: 'ارسال‌شده' };
const eventSchema = upcomingEvent ? {
  '@context': 'https://schema.org', '@type': 'Event',
  name: upcomingEvent.titleFa, description: upcomingEvent.descriptionFa, inLanguage: 'fa-IR',
  startDate: upcomingEvent.startDate, endDate: upcomingEvent.endDate,
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  url: `${site.domain}/fa/upcoming/`, image: `${site.domain}${upcomingEvent.image}`,
  location: { '@type': 'Place', name: upcomingEvent.venue, address: { '@type': 'PostalAddress', addressLocality: 'Hamburg', addressCountry: 'DE' } },
  organizer: { '@type': 'Organization', name: 'IEEE Vehicular Technology Society', url: upcomingEvent.conferenceUrl },
  performer: { '@type': 'Person', '@id': `${site.domain}/#person`, name: site.name, alternateName: site.alternateName },
  about: { '@type': 'ScholarlyArticle', name: upcomingEvent.paperTitle, url: `${site.domain}/fa${upcomingEvent.researchUrl}/` }
} : null;

const sectionVisuals = {
  research: { image: '/images/profile/meysam-ghanbari-space-communications-researcher.webp', label: 'حوزه پژوهشی', width: 1122, height: 1402 },
  projects: { image: '/images/profile/meysam-ghanbari-satellite-optical-communications.webp', label: 'مسیرهای مهندسی', width: 1122, height: 1402 },
  publications: { image: '/images/profile/meysam-ghanbari-space-communications-researcher.webp', label: 'کتابخانه مقالات', width: 1122, height: 1402 },
  videos: { image: '/images/media/meysam-ghanbari-research-presentation.webp', label: 'ارائه‌ها و سخنرانی‌ها', width: 1672, height: 941 },
  insights: { image: '/images/profile/meysam-ghanbari-satellite-optical-communications.webp', label: 'دیدگاه‌های فنی', width: 1122, height: 1402 },
  upcoming: { image: upcomingEvent?.image ?? '/images/media/meysam-ghanbari-research-presentation.webp', label: 'IEEE VTC 2027-Spring · هامبورگ', width: 1280, height: 720 },
  media: { image: '/images/profile/meysam-ghanbari-formal-portrait.webp', label: 'آرشیو رسانه', width: 1024, height: 1536 },
  about: { image: '/images/profile/meysam-ghanbari-professional-headshot.webp', label: 'پروفایل پژوهشی', width: 1086, height: 1448 },
  contact: { image: '/images/media/meysam-ghanbari-research-workspace.webp', label: 'ارتباط پژوهشی', width: 1672, height: 941 }
} as const;

const visual = sectionVisuals[section];
---

<BaseLayout
  title={data.title}
  description={section === 'upcoming' && upcomingEvent ? 'میثم قنبری در IEEE VTC 2027-Spring در هامبورگ پژوهش خود درباره گیرنده نوری چندشاخه برای لینک‌های بین HAPS را ارائه خواهد کرد.' : data.intro}
  lang="fa"
  path={path}
  image={section === 'upcoming' && upcomingEvent ? upcomingEvent.image : undefined}
  imageAlt={section === 'upcoming' && upcomingEvent ? upcomingEvent.imageAlt : undefined}
>
  {section === 'upcoming' && eventSchema && <script type="application/ld+json" slot="head" set:html={JSON.stringify(eventSchema)}></script>}
  
<section class={`page-hero page-hero-space page-hero-${section}`}>
  <div class="space-grid-bg" aria-hidden="true"></div>
  <div class="page-hero-backdrop" style={`background-image:url('${visual.image}')`}></div>
  <div class="page-hero-orbit" aria-hidden="true"></div>
  <div class="shell page-hero-shell">
    <div class="page-hero-copy narrow">
      <p class="eyebrow">{data.kicker}</p>
      <h1>{data.title}</h1>
      <p class="page-intro">{data.intro}</p>
    </div>
    <div class="page-hero-sidecard">
      <img src={visual.image} alt={visual.label} width={visual.width} height={visual.height} loading="eager" />
      <div>
        <span>{visual.label}</span>
        <small>{site.name}</small>
      </div>
    </div>
  </div>
</section>

  {section === 'research' && (
    <section class="section section-tight">
      <div class="shell">
        <a class="research-record-feature" href="/fa/research/optical-communications-records/">
          <div class="research-record-copy">
            <span>جدید · رصدخانه فنی</span>
            <h2>رصدخانه رکوردهای مخابرات نوری و ماهواره‌ای</h2>
            <p>رکوردهای تأییدشدهٔ سرعت، برد، رهگیری، رله، لینک‌های کوانتومی و انتقال توان نوری را همراه با روش مهندسی، پروژه و منبع اولیه بررسی کنید.</p>
            <div dir="ltr"><strong>200 Gbit/s</strong><strong>460M km</strong><strong>30 ps</strong><strong>&gt;800 W</strong></div>
            <b>ورود به رصدخانه رکوردها ←</b>
          </div>
          <img src="/images/records/optical-record-observatory-photorealistic.webp" alt="نمای واقع‌گرایانه لینک‌های مخابرات نوری در مدار زمین، فاصله ماه و اعماق فضا" width="1672" height="941" loading="eager" />
        </a>
        <div class="domain-grid research-domain-grid">
          {site.themes.fa.map(([title, text], i) => (
            <article class={`domain-card domain-card-${(i % 4) + 1}`}>
              <span class="domain-index">0{i + 1}</span>
              <h2>{title}</h2>
              <p>{text}</p>
              <div class="domain-links">
                {researchDomainLinks[i].project && <a href={`/fa/projects/${researchDomainLinks[i].project}/`}>پروژه مرتبط ←</a>}
                <a href={`/fa/publications/${researchDomainLinks[i].publication}/`}>مقاله مرتبط ←</a>
              </div>
            </article>
          ))}
        </div>
        <div class="expertise-panel">
          <div>
            <p class="eyebrow">پروفایل فنی</p>
            <h2>مدل‌سازی تحلیلی، طراحی گیرنده و پیاده‌سازی سامانه‌های مخابراتی</h2>
          </div>
          <div class="expertise-list" dir="ltr">
            <span>Link budgets & Gaussian-beam propagation</span>
            <span>Receiver noise & sensitivity</span>
            <span>Photodetector / TIA interfaces</span>
            <span>Pointing error & jitter</span>
            <span>Acquisition, alignment & fine tracking</span>
            <span>BER / SER / outage modeling</span>
            <span>Monte Carlo simulation & optimization</span>
            <span>MATLAB · Python · C · FPGA</span>
          </div>
        </div>
      </div>
    </section>
  )}

  {section === 'projects' && (
    <section class="section section-tight">
      <div class="shell">
        <div class="project-portfolio-grid project-index-grid">
          {projects.fa.map((project, i) => (
            <a class="project-portfolio-card" href={project.href}>
              <div class="project-card-top"><span>0{i + 1}</span><span>پژوهش ارسال‌شده</span></div>
              <p class="tag">{project.tag}</p>
              <h2>{project.title}</h2>
              <p>{project.summary}</p>
              <div class="project-meta"><span>معماری</span><span>تحلیل</span><span>شبیه‌سازی</span></div>
              <span class="project-explore">بررسی پروژه <b>↖</b></span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {section === 'publications' && (
    <section class="section section-tight">
      <div class="shell">
        <div class="publication-group">
          <div class="group-heading"><span>JOURNALS</span><strong>{journals.length}</strong></div>
          <div class="publication-card-grid">
            {journals.map((paper, index) => (
              <a class="publication-card" href={`/fa/publications/${paper.slug}/`}>
                <div class="publication-card-head"><span>J{String(index + 1).padStart(2, '0')}</span><span>{paper.year} · {paper.venue}</span></div>
                <span class={`status-pill status-${paper.status.toLowerCase()}`}>{statusFa[paper.status]}</span>
                <h2 dir="ltr">{paper.title}</h2><p>{paper.summaryFa}</p>
                <div class="tag-cloud" dir="ltr">{paper.tags.slice(0, 4).map((tag) => <span>{tag}</span>)}</div>
                <span class="project-explore">بررسی مقاله <b>↖</b></span>
              </a>
            ))}
          </div>
        </div>
        <div class="publication-group">
          <div class="group-heading"><span>CONFERENCES</span><strong>{conferences.length}</strong></div>
          <div class="publication-card-grid">
            {conferences.map((paper, index) => (
              <a class="publication-card" href={`/fa/publications/${paper.slug}/`}>
                <div class="publication-card-head"><span>C{String(index + 1).padStart(2, '0')}</span><span>{paper.year} · {paper.venue}</span></div>
                <span class={`status-pill status-${paper.status.toLowerCase()}`}>{statusFa[paper.status]}</span>
                <h2 dir="ltr">{paper.title}</h2><p>{paper.summaryFa}</p>
                <div class="tag-cloud" dir="ltr">{paper.tags.slice(0, 4).map((tag) => <span>{tag}</span>)}</div>
                <span class="project-explore">بررسی مقاله <b>↖</b></span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>
  )}

  {section === 'videos' && (
    <section class="section section-tight"><div class="shell">
      {videos.length === 0 ? <div class="empty-state"><span class="empty-icon">▶</span><h2>ویدئوی عمومی ثبت نشده است</h2><p>ارائه‌های پژوهشی و محتوای فنی عمومی در این بخش نمایش داده خواهند شد.</p></div> : null}
    </div></section>
  )}

  {section === 'insights' && (
    <section class="section section-tight"><div class="shell">
      {insights.length === 0 ? <div class="empty-state insight-empty"><span class="empty-icon">✦</span><h2>دیدگاه‌ها</h2><p>هنوز دیدگاه فنی عمومی در این بخش منتشر نشده است.</p></div> : null}
    </div></section>
  )}

  {section === 'upcoming' && (
    <section class="section section-tight"><div class="shell">
      {upcoming.length === 0 ? (
        <div class="upcoming-empty"><div class="upcoming-orbit" aria-hidden="true"></div><p class="eyebrow">تقویم</p><h2>در حال حاضر رویداد عمومی پیش‌رو ثبت نشده است.</h2><p>برای دعوت، بازدید پژوهشی یا درخواست سخنرانی از صفحه ارتباط استفاده شود.</p><a class="button ghost" href="/fa/contact">ارسال دعوت</a></div>
      ) : (
        <div class="upcoming-list">
          {upcoming.map((item) => (
            <article class="upcoming-feature">
              <div class="upcoming-feature-copy">
                <div class="event-status-line"><span class="status-pill status-scheduled">برنامه‌ریزی‌شده</span><span>{item.date}</span><span>{item.locationFa}</span></div>
                <p class="eyebrow">سؤال پژوهشی</p>
                <h2>{item.questionFa}</h2>
                <p class="event-answer">{item.descriptionFa}</p>
                <div class="event-paper"><span>مقاله ارائه</span><h3><a href={item.paperUrl} target="_blank" rel="noreferrer">{item.paperTitle}</a></h3></div>
                <div class="tag-cloud event-tags">{item.tags.map((tag) => <span>{tag}</span>)}</div>
                <div class="event-actions"><a class="button" href={item.conferenceUrl} target="_blank" rel="noreferrer">وب‌سایت رسمی کنفرانس ↗</a><a class="button ghost" href={item.paperUrl} target="_blank" rel="noreferrer">Google Scholar ↗</a><a class="text-link" href={`/fa${item.researchUrl}`}>مشاهده پژوهش ←</a></div>
              </div>
              <figure class="upcoming-feature-visual"><img src={item.image} alt={item.imageAlt} width="1280" height="720" loading="eager" /><figcaption><span>{item.conference}</span><small>{item.typeFa} · {item.venue}</small></figcaption></figure>
            </article>
          ))}
        </div>
      )}
    </div></section>
  )}

  {section === 'media' && (
    <section class="section section-tight"><div class="shell"><div class="media-grid-v2">
      {media.map((item, i) => <figure class={`media-card media-card-${i + 1}`}><img src={item.src} alt={item.alt} width={i < 2 ? 1122 : i < 4 ? 1672 : i === 4 ? 1024 : 1086} height={i < 2 ? 1402 : i < 4 ? 941 : i === 4 ? 1536 : 1448} loading={i < 2 ? 'eager' : 'lazy'} /><figcaption>{item.labelFa}</figcaption></figure>)}
    </div></div></section>
  )}

  {section === 'about' && (
    <section class="section section-tight"><div class="shell about-grid about-grid-v2">
      <div class="about-visual"><img class="about-portrait" src="/images/profile/meysam-ghanbari-satellite-optical-communications.webp" alt="میثم قنبری در محیط پژوهشی ماهواره و مخابرات نوری" width="1122" height="1402" loading="lazy" /></div>
      <div class="prose">
        <p class="eyebrow">پروفایل</p><h2>سامانه‌های مخابرات نوری، ماهواره‌ای و پیشرفته</h2>
        <p>میثم قنبری پژوهشگر و مهندسی در حوزه مخابرات ماهواره‌ای و نوری است و فعالیت فنی او لینک‌های نوری بین‌ماهواره‌ای، FSO، طراحی گیرنده و TIA و مسائل pointing، acquisition و tracking را پوشش می‌دهد.</p>
        <p>کار فنی او شامل مدل‌سازی تحلیلی و مونت‌کارلو برای بودجه لینک، نویز گیرنده، انتشار پرتو، هم‌ترازی، BER/SER و outage و همچنین FPGA، MATLAB/Python/C، دوقلوهای دیجیتال فیزیک‌محور و اتوماسیون صنعتی است.</p>
        <h2>تمرکز پژوهشی</h2><ul><li>لینک‌های نوری بین‌ماهواره‌ای</li><li>سامانه‌های FSO و شبکه‌های غیرزمینی</li><li>معماری گیرنده و حساسیت</li><li>PAT و رهگیری دقیق</li><li>لینک‌های کوانتومی</li><li>مدل‌سازی تحلیلی، مونت‌کارلو و دوقلوهای دیجیتال</li></ul>
        <div class="about-actions"><a class="button" href="/fa/publications">کتابخانه مقالات</a><a class="button ghost" href="/fa/contact">ارتباط پژوهشی</a></div>
      </div>
    </div></section>
  )}

  {section === 'contact' && (
    <section class="section section-tight"><div class="shell contact-layout">
      <div class="contact-paths">
        <p class="eyebrow">مسیر ارتباط حرفه‌ای</p><h2>مسئلهٔ پژوهشی خود را مطرح کنید.</h2>
        <p>زمینهٔ فنی، سازمان یا دانشگاه و شکل همکاری موردنظر را مشخص کنید. درخواست‌ها مستقیماً برای میثم قنبری آماده می‌شوند.</p>
        <div class="contact-path-grid">
          <div><strong>همکاری پژوهشی</strong><span>پژوهش مشترک، مقاله و بازدید پژوهشی</span></div>
          <div><strong>صنعت و تحقیق‌وتوسعه</strong><span>چالش‌های سامانه‌های نوری، ماهواره‌ای و پیشرفته</span></div>
          <div><strong>مشاورهٔ فنی</strong><span>مدل‌سازی، معماری و تحلیل سامانه</span></div>
          <div><strong>سخنرانی و رسانه</strong><span>ارائه، مصاحبه و گفتگوی فنی</span></div>
        </div>
        <a class="direct-email" href={`mailto:${site.contactEmail}`}><small>ایمیل مستقیم</small><strong dir="ltr">{site.contactEmail}</strong><span>↗</span></a>
      </div>
      <form class="enquiry-form" data-enquiry-form-fa data-email={site.contactEmail}>
        <div class="form-head"><span>درخواست ساختاریافته</span><small>همهٔ فیلدها به‌جز سازمان ضروری‌اند</small></div>
        <label>نام<input type="text" name="name" autocomplete="name" required /></label>
        <label>ایمیل<input type="email" name="email" autocomplete="email" dir="ltr" required /></label>
        <label>سازمان / دانشگاه<input type="text" name="organization" autocomplete="organization" /></label>
        <label>حوزهٔ علاقه<input type="text" name="area" placeholder="برای نمونه: لینک‌های نوری بین‌ماهواره‌ای" required /></label>
        <label>نوع درخواست<select name="requestType" required>
          <option value="">نوع درخواست را انتخاب کنید</option>
          <option>همکاری پژوهشی</option><option>مشاورهٔ فنی</option><option>راهنمایی پروژه</option><option>تحقیق‌وتوسعهٔ صنعتی</option><option>بازدید پژوهشی</option><option>سخنرانی / ارائه</option><option>سایر</option>
        </select></label>
        <label>پیام<textarea name="message" rows="6" required></textarea></label>
        <button class="button" type="submit">آماده‌سازی ایمیل</button>
        <p class="form-note">این دکمه برنامهٔ ایمیل شما را با متن آماده‌شده باز می‌کند. پیام پس از بررسی و ارسال شما تحویل داده می‌شود.</p>
      </form>
    </div>
    <script>
      const form = document.querySelector<HTMLFormElement>('[data-enquiry-form-fa]');
      form?.addEventListener('submit', (event) => {
        event.preventDefault();
        const data = new FormData(form);
        const recipient = form.getAttribute('data-email');
        const subject = `${data.get('requestType')} — ${data.get('area')}`;
        const body = `نام: ${data.get('name')}\nایمیل: ${data.get('email')}\nسازمان / دانشگاه: ${data.get('organization') || 'ذکر نشده'}\nحوزهٔ علاقه: ${data.get('area')}\nنوع درخواست: ${data.get('requestType')}\n\nپیام:\n${data.get('message')}`;
        window.location.href = `mailto:${recipient}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      });
    </script>
    </section>
  )}
</BaseLayout>
