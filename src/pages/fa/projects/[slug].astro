---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { projects, publications } from '../../../data/library';
import { projectDetailsFa } from '../../../data/projects-fa';
import { site } from '../../../data/site';

export function getStaticPaths() {
  return projects.en.map((project, index) => ({
    params: { slug: project.slug },
    props: { project, localized: projects.fa[index] }
  }));
}

const { project, localized } = Astro.props;
const detail = projectDetailsFa[project.slug];
const path = `/fa/projects/${project.slug}/`;
const related = publications.filter((paper) => project.relatedPublicationSlugs.includes(paper.slug));
const schema = {
  '@context': 'https://schema.org', '@type': 'CreativeWork',
  name: localized.title, description: localized.summary, inLanguage: 'fa-IR',
  url: `${site.domain}${path}`,
  creator: { '@type': 'Person', '@id': `${site.domain}/#person`, name: site.name, alternateName: site.alternateName },
  about: project.tags
};
---

<BaseLayout title={localized.title} description={localized.summary} lang="fa" path={path} languagePath={`/projects/${project.slug}/`} image="/images/profile/meysam-ghanbari-satellite-optical-communications.webp" breadcrumbNames={['پروژه‌ها', localized.title]}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(schema)}></script>
  <section class="project-hero">
    <div class="space-grid-bg" aria-hidden="true"></div>
    <div class="project-hero-orbit" aria-hidden="true"></div>
    <div class="shell project-hero-grid">
      <div>
        <a class="back-link" href="/fa/projects/">پروژه‌ها ←</a>
        <div class="project-kicker"><span>{project.number}</span><span>{localized.tag}</span><span>پژوهش ارسال‌شده</span></div>
        <h1>{localized.title}</h1><p>{localized.summary}</p>
        <div class="project-meta">{project.tags.map((tag) => <span>{tag}</span>)}</div>
      </div>
      <div class="project-hero-panel"><small>حوزهٔ فنی</small><strong>{localized.tag}</strong><div><span>مسئله</span><span>معماری</span><span>تحلیل</span><span>شواهد</span></div></div>
    </div>
  </section>
  <section class="section project-story"><div class="shell project-story-grid">
    <article class="project-story-main">
      <section><p class="eyebrow">۰۱ · مسئله</p><h2>این پروژه چه مسئله‌ای را بررسی می‌کند؟</h2><p>{detail.problem}</p></section>
      <section><p class="eyebrow">۰۲ · ایده</p><h2>مفهوم سامانه</h2><p>{detail.idea}</p></section>
      <section><p class="eyebrow">۰۳ · روش</p><h2>رویکرد فنی</h2><div class="method-grid">{detail.approach.map((item, index) => <div><span>0{index + 1}</span><strong>{item}</strong></div>)}</div></section>
      <section><p class="eyebrow">۰۴ · سهم پژوهشی</p><h2>مشارکت‌های اصلی</h2><ul class="contribution-list">{detail.contributions.map((item) => <li>{item}</li>)}</ul></section>
      <section><p class="eyebrow">۰۵ · اهمیت</p><h2>اهمیت مهندسی</h2><p>{detail.relevance}</p></section>
      {related.length > 0 && <section><p class="eyebrow">مقاله مرتبط</p><h2>رکورد پژوهشی</h2><div class="related-records">{related.map((paper) => <a href={`/fa/publications/${paper.slug}/`}><span>{paper.year} · {paper.status}</span><strong dir="ltr">{paper.title}</strong><small>{paper.venue} ↖</small></a>)}</div></section>}
    </article>
    <aside class="project-story-sidebar"><div class="side-card sticky-card"><p class="eyebrow">در یک نگاه</p><dl><div><dt>حوزه</dt><dd>{localized.tag}</dd></div><div><dt>وضعیت</dt><dd>پژوهش ارسال‌شده</dd></div><div><dt>پژوهشگر</dt><dd>میثم قنبری</dd></div></dl></div><div class="side-card"><p class="eyebrow">پژوهش مرتبط</p><a class="text-link" href="/fa/research/">حوزه‌های پژوهشی ←</a><a class="text-link" href="/fa/publications/">کتابخانه مقالات ←</a></div></aside>
  </div></section>
  <section class="section section-collaboration"><div class="shell collaboration-card"><div><p class="eyebrow">فرصت همکاری</p><h2>دربارهٔ یک مسئله فنی مرتبط گفت‌وگو کنید.</h2><p>درخواست همکاری پژوهشی و صنعتی مرتبط با این پروژه از مسیر ارتباط قابل ارسال است.</p></div><a class="button light" href="/fa/contact/">ارتباط پژوهشی</a></div></section>
</BaseLayout>
