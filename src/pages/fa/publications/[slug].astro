---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { publications } from '../../../data/library';
import { publicationSeoTitle } from '../../../data/publication-seo';
import { publicationSchema } from '../../../data/publication-schema';
import { publicationDetailsFa } from '../../../data/publication-details-fa';
import { projects } from '../../../data/library';

export function getStaticPaths() {
  return publications.map((paper) => ({ params: { slug: paper.slug }, props: { paper } }));
}

const { paper } = Astro.props;
const path = `/fa/publications/${paper.slug}`;
const [problem, idea, relevance] = publicationDetailsFa[paper.slug];
const relatedProjects = projects.en.filter((project) => paper.relatedProjectSlugs?.includes(project.slug));
const relatedPapers = publications.filter((candidate) => candidate.slug !== paper.slug && candidate.tags.some((tag) => paper.tags.includes(tag))).slice(0, 3);
---

<BaseLayout title={paper.title} seoTitle={publicationSeoTitle(paper.slug, 'fa')} description={paper.summaryFa} lang="fa" path={path}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(publicationSchema(paper, 'fa'))}></script>
  <section class="paper-hero">
    <div class="space-grid-bg" aria-hidden="true"></div>
    <div class="shell paper-shell">
      <a class="back-link" href="/fa/publications">مقالات ←</a>
      <div class="paper-meta-line" dir="ltr"><span>{paper.type}</span><span>{paper.year}</span><span class={`status-pill status-${paper.status.toLowerCase()}`}>{paper.status}</span></div>
      <h1 dir="ltr">{paper.title}</h1>
      <p class="paper-authors" dir="ltr">{paper.authors}</p>
      <p class="paper-venue" dir="ltr">{paper.venue}</p>
      <div class="paper-actions">
        {paper.doi && <a class="button" href={paper.doi} target="_blank" rel="noreferrer">DOI ↗</a>}
        {paper.pdf && <a class="button ghost" href={paper.pdf} target="_blank" rel="noreferrer">PDF ↗</a>}
        {paper.externalUrl && <a class="button ghost" href={paper.externalUrl} target="_blank" rel="noreferrer">رکورد ناشر ↗</a>}
      </div>
      <div class="paper-signal-line" dir="ltr" aria-label="موضوع‌های پژوهش">{paper.tags.map((tag) => <span>{tag}</span>)}</div>
    </div>
  </section>

  <section class="section paper-body-section">
    <div class="shell paper-content-grid">
      <article class="paper-main">
        <p class="eyebrow">مرور پژوهش</p>
        <h2>مرور کلی</h2>
        <p class="paper-summary">{paper.summaryFa}</p>
        <h2>مسئله پژوهش</h2><p>{problem}</p>
        <h2>ایده اصلی</h2><p>{idea}</p>
        <h2>چرا اهمیت دارد؟</h2><p>{relevance}</p>
        <div class="evidence-note"><strong>نتایج و شواهد</strong><p>نتایج عددی فقط پس از تطبیق با نسخه عمومی و تأییدشده مقاله افزوده می‌شوند. وضعیت انتشار در مشخصات زیر درج شده است و این توضیح جایگزین متن اصلی مقاله نیست.</p></div>
        <h2>مشخصات انتشار</h2>
        <dl class="paper-record">
          <div><dt>نویسندگان</dt><dd dir="ltr">{paper.authors}</dd></div>
          <div><dt>محل انتشار</dt><dd dir="ltr">{paper.venue}</dd></div>
          <div><dt>سال</dt><dd>{paper.year}</dd></div>
          <div><dt>وضعیت</dt><dd>{paper.status}</dd></div>
        </dl>
        {relatedProjects.length > 0 && <><h2>پروژه‌های مرتبط</h2><div class="related-records">{relatedProjects.map((project) => <a href={`/fa/projects/${project.slug}/`}><span>{project.number} · {project.category}</span><strong>{projects.fa[projects.en.indexOf(project)].title}</strong><small>بررسی پروژه ←</small></a>)}</div></>}
        {relatedPapers.length > 0 && <><h2>پژوهش‌های مرتبط</h2><div class="related-records">{relatedPapers.map((related) => <a href={`/fa/publications/${related.slug}/`}><span>{related.year} · {related.status}</span><strong dir="ltr">{related.title}</strong><small>{related.venue} ↖</small></a>)}</div></>}
      </article>
      <aside class="paper-sidebar">
        <div class="side-card"><p class="eyebrow">کلیدواژه‌ها</p><div class="tag-cloud" dir="ltr">{paper.tags.map((tag) => <span>{tag}</span>)}</div></div>
        <div class="side-card"><p class="eyebrow">ارتباط</p><p>برای گفت‌وگوی فنی، همکاری پژوهشی یا پروژه‌های مرتبط از صفحه ارتباط استفاده شود.</p><a class="text-link" href="/fa/contact">ارتباط ←</a></div>
        <div class="side-card"><p class="eyebrow">دربارهٔ این صفحه</p><p>این توضیح، برداشت تحریریه‌ای از رکورد عمومی پژوهش است. وضعیت ارسال، پذیرش یا انتشار را باید از مشخصات مقاله جداگانه خواند.</p></div>
      </aside>
    </div>
  </section>
</BaseLayout>
