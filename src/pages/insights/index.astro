---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';
import { insights } from '../../data/insights';
import { engineeringPaths } from '../../data/future-systems';
const featuredEssays = [insights[9], insights[10], insights[0]];
const collectionSchema = {
  '@context':'https://schema.org', '@type':'CollectionPage', name:'Future Systems', url:`${site.domain}/insights/`,
  description:'Engineering reading paths for space, optical and quantum networks, with a separate collection on intelligence, governance and civilization.',
  author:{ '@type':'Person', '@id':`${site.domain}/#person`, name:site.name },
  hasPart:engineeringPaths.map(item => ({ '@type':'CreativeWork', name:item.title, url:`${site.domain}${item.href}` }))
};
---
<BaseLayout title="Future Systems" description="Explore engineering perspectives on space, optical and quantum networks, followed by Meysam Ghanbari’s essays on intelligence, governance and civilization." path="/insights/" image="/images/records/deep-space-optical-communications-photorealistic.webp" imageAlt="Concept illustration of a deep-space optical communications link">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(collectionSchema)}></script>
  <section class="systems-hero"><div class="shell systems-hero-grid"><div><p class="systems-kicker">FUTURE SYSTEMS · MEYSAM GHANBARI</p><h1>Engineering the next connection.</h1><p>How do future networks connect across space, recover information from narrow optical beams and coordinate quantum infrastructure?</p><p class="systems-intro">Explore these questions through Meysam Ghanbari’s research portfolio and a source-backed observatory of optical communication capabilities.</p><a class="button" href="#engineering-paths">Explore engineering paths →</a></div><figure><img src="/images/records/deep-space-optical-communications-photorealistic.webp" alt="Concept illustration of an optical link between spacecraft and Earth" width="1672" height="941" loading="eager" /><figcaption>Concept illustration · Space optical communications</figcaption></figure></div></section>
  <section id="engineering-paths" class="systems-section"><div class="shell"><div class="systems-heading"><div><p class="systems-kicker">TECHNICAL READING PATHS</p><h2>Space. Optical. Quantum.</h2></div><p>Each path leads to an existing research brief, project or technical reference. Publication status and demonstrated results remain visible in their original records.</p></div><div class="systems-paths">{engineeringPaths.map((item,index) => <a href={item.href}><span class="systems-path-number">0{index+1}</span><div><p class="systems-kicker">{item.category}</p><h3>{item.title}</h3><p>{item.description}</p><strong>{item.label} →</strong></div></a>)}</div></div></section>
  <section class="systems-evidence"><div class="shell"><div><p class="systems-kicker">AN EVIDENCE-LED VIEW</p><h2>What has been demonstrated?<br />What remains a target?</h2><p>The Optical Record Observatory keeps experimental demonstrations, operational systems and announced targets distinct, with source links and engineering context.</p></div><a class="button ghost" href="/research/optical-communications-records/">Open the observatory ↗</a></div></section>
  <section id="civilization" class="systems-section systems-civilization"><div class="shell"><div class="systems-heading"><div><p class="systems-kicker">BEYOND COMMUNICATIONS</p><h2>Intelligence, Governance<br />& Civilization</h2></div><p>A separate collection of {insights.length} essays explores institutions, human progress and the long-term future. These essays present perspectives, values and open questions alongside factual sources.</p></div><div class="systems-essays">{featuredEssays.map(item => <a href={`/insights/${item.slug}/`}><span>{item.number} · {item.readTime}</span><h3>{item.cardTitle}</h3><p>{item.excerpt}</p><strong>Read the essay →</strong></a>)}</div><a class="systems-collection-link" href="/insights/intelligence-governance/">Explore the complete civilization collection →</a></div></section>
  <section class="systems-footer"><div class="shell"><h2>Bring a technical question.</h2><p>For research collaboration, industrial R&D and technical discussion, contact Meysam Ghanbari.</p><a class="button" href="/contact/">Start a conversation ↗</a></div></section>
</BaseLayout>
<style>
.systems-kicker { font-size:11px; color:#87dff4; letter-spacing:.14em; font-weight:750; text-transform:uppercase; margin:0; }
.systems-hero { padding:74px 0; background:radial-gradient(ellipse at 85% 0,#16374d88,transparent 65%),#050b13; border-bottom:1px solid var(--line); }
.systems-hero-grid { display:grid; grid-template-columns:minmax(0,1.2fr) minmax(0,1fr); gap:65px; align-items:center; }
.systems-hero h1 { font-size:clamp(38px,4.5vw,62px); line-height:1.04; letter-spacing:-.045em; margin:18px 0 22px; }
.systems-hero p:not(.systems-kicker) { color:#becbdd; line-height:1.65; font-size:19px; margin:0 0 20px; }
.systems-hero p.systems-intro { font-size:15px; color:#aabdd3; }
.systems-hero figure { margin:0; border:1px solid #34475b; border-radius:4px; overflow:hidden; }
.systems-hero img { display:block; width:100%; aspect-ratio:4/3; object-fit:cover; }
.systems-hero figcaption { padding:13px 16px; color:#aabdd3; font-size:11px; background:#0a1422; }
.systems-section { padding:76px 0; scroll-margin-top:95px; }
.systems-heading { display:flex; justify-content:space-between; gap:55px; align-items:end; margin-bottom:34px; }
.systems-heading h2 { margin:14px 0 0; font-size:clamp(29px,3.5vw,45px); line-height:1.12; letter-spacing:-.035em; }
.systems-heading > p { max-width:440px; margin:0; color:#b7c6d9; font-size:15px; line-height:1.65; }
.systems-paths { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:20px; }
.systems-paths > a { display:flex; gap:23px; padding:30px; background:#0a1524; border:1px solid #34475b; border-radius:4px; }
.systems-paths > a:hover { border-color:#6eafbf; }
.systems-path-number { font-size:24px; color:#7f9db9; font-weight:500; }
.systems-paths h3 { font-size:26px; letter-spacing:-.03em; line-height:1.15; margin:14px 0; }
.systems-paths p:not(.systems-kicker) { font-size:14px; color:#b8c8db; line-height:1.65; }
.systems-paths strong, .systems-essays strong { display:inline-block; padding-top:10px; color:#98dff1; font-size:12px; font-weight:600; }
.systems-evidence { padding:55px 0; background:#0b2031; border-block:1px solid var(--line); }
.systems-evidence .shell { display:flex; align-items:center; justify-content:space-between; gap:50px; }
.systems-evidence h2 { font-size:32px; letter-spacing:-.03em; line-height:1.16; margin:15px 0; }
.systems-evidence p:not(.systems-kicker) { max-width:660px; color:#bccbdc; line-height:1.65; font-size:15px; }
.systems-evidence .button { flex:none; }
.systems-civilization { background:#070f1b; border-bottom:1px solid var(--line); }
.systems-essays { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:25px; }
.systems-essays > a { border-top:1px solid #4a5061; padding:24px 0; }
.systems-essays > a > span { color:#c2b8de; font-size:11px; }
.systems-essays h3 { font-size:23px; line-height:1.2; margin:15px 0; }
.systems-essays p { color:#b3c2d6; line-height:1.65; font-size:14px; }
.systems-collection-link { display:inline-flex; align-items:center; min-height:44px; color:#b9c7df; font-size:13px; margin-top:15px; }
.systems-footer { padding:60px 0; text-align:center; }
.systems-footer h2 { font-size:32px; letter-spacing:-.03em; margin:0 0 15px; }
.systems-footer p { color:#b9c8dc; margin-bottom:25px; }
@media(max-width:900px) { .systems-hero-grid { gap:30px; } .systems-paths > a { padding:23px; gap:15px; } .systems-heading { flex-direction:column; align-items:start; gap:20px; } .systems-evidence .shell { flex-direction:column; align-items:start; gap:18px; } }
@media(max-width:600px) { .systems-hero { padding:42px 0; } .systems-hero-grid, .systems-paths, .systems-essays { grid-template-columns:1fr; } .systems-hero img { aspect-ratio:16/9; } .systems-hero p:not(.systems-kicker) { font-size:17px; } .systems-section { padding:50px 0; } .systems-paths h3 { font-size:24px; } .systems-path-number { font-size:19px; } .systems-hero h1 { font-size:40px; } }
</style>
