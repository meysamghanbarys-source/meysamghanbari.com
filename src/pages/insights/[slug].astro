---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';
import { insights } from '../../data/insights';

export function getStaticPaths() {
  return insights.map((insight) => ({ params: { slug: insight.slug }, props: { insight } }));
}

const { insight } = Astro.props;
const related = insight.related.map((slug) => insights.find((item) => item.slug === slug)).filter(Boolean);
const visualIndex = Number(insight.number) - 1;
const portraitPositions = ['22%','34%','17%','42%','28%','11%','38%','25%','46%','72%','81%','18%','67%','31%','44%'];
const heroHues = [0,8,-5,14,-9,4,18,-12,7,0,-7,16,5,-18,11];
const canonical = `${site.domain}/insights/${insight.slug}`;
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': `${canonical}#article`,
  headline: insight.title,
  description: insight.metaDescription,
  image: [`${site.domain}${insight.portrait}`, `${site.domain}${insight.conceptImage}`],
  datePublished: insight.datePublished,
  dateModified: insight.dateModified,
  mainEntityOfPage: canonical,
  articleSection: insight.domain,
  keywords: [insight.primaryKeyword, ...insight.keywords].join(', '),
  author: { '@type': 'Person', '@id': `${site.domain}/#person`, name: site.name, url: site.domain },
  publisher: { '@type': 'Person', '@id': `${site.domain}/#person`, name: site.name, url: site.domain }
};
---

<BaseLayout
  title={insight.seoTitle.replace(' | Meysam Ghanbari', '')}
  description={insight.metaDescription}
  path={`/insights/${insight.slug}`}
  image={insight.portrait}
  imageAlt={insight.portraitAlt}
  ogType="article"
  languagePath={`/fa/insights/${insight.slug}`}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(articleSchema)}></script>
  <meta property="article:published_time" content={insight.datePublished} slot="head" />
  <meta property="article:modified_time" content={insight.dateModified} slot="head" />
  <meta property="article:author" content={site.name} slot="head" />

  <article class={`future-article theme-${insight.theme} visual-variant-${(visualIndex % 5) + 1}`} style={`--portrait-x:${portraitPositions[visualIndex]};--hero-hue:${heroHues[visualIndex]}deg`}>
    <header class="future-article-hero">
      <img class="future-article-backdrop" src={insight.portrait} alt="" aria-hidden="true" />
      <div class="future-article-veil" aria-hidden="true"></div>
      <div class="shell future-article-hero-grid">
        <div class="future-article-heading">
          <a class="future-breadcrumb" href="/insights">Future Systems</a>
          <span aria-hidden="true">/</span>
          <a class="future-breadcrumb" href={`/insights/${insight.domainSlug}`}>{insight.domain}</a>
          <div class="future-meta"><span>INSIGHT {insight.number}</span><span>{insight.readTime} read</span><time datetime={insight.datePublished}>18 September 2026</time></div>
          <h1>{insight.title}</h1>
          <p>{insight.hook}</p>
        </div>
        <figure class="future-portrait-frame">
          <img src={insight.portrait} alt={insight.portraitAlt} width="1672" height="941" loading="eager" />
          <figcaption>Meysam Ghanbari · Future Systems</figcaption>
        </figure>
      </div>
    </header>

    <div class="shell future-article-layout">
      <aside class="future-article-rail" aria-label="Article information">
        <span class="rail-label">DOMAIN</span><a href={`/insights/${insight.domainSlug}`}>{insight.domain}</a>
        <span class="rail-label">PRIMARY TOPIC</span><strong>{insight.primaryKeyword}</strong>
        <span class="rail-label">AUTHOR</span><a href="/about">Meysam Ghanbari</a>
        <span class="rail-label">EXPLORE</span><a href="/insights">All Future Systems Insights</a>
      </aside>

      <div class="future-article-body">
        <section class="future-thesis" aria-label="Thesis">
          <span>THE THESIS</span>
          <p>{insight.thesis}</p>
        </section>

        {insight.sections.map((section, index) => (
          <>
            <section class="future-copy-section">
              <span class="section-marker">0{index + 1}</span>
              <h2>{section.heading}</h2>
              {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            </section>
            {index === 1 && (
              <figure class="future-concept-figure">
                <img src={insight.conceptImage} alt={insight.conceptAlt} width="1200" height="675" loading="lazy" />
                <figcaption>{insight.conceptAlt}. Original Future Systems visual.</figcaption>
              </figure>
            )}
          </>
        ))}

        <section class="future-tension">
          <span>THE HARD QUESTION</span>
          <h2>{insight.tensionTitle}</h2>
          {insight.tension.map((paragraph) => <p>{paragraph}</p>)}
        </section>

        <section class="future-conclusion">
          <span>CONCLUSION</span>
          <p>{insight.conclusion}</p>
        </section>

        <section class="future-faq" aria-labelledby="faq-title">
          <p class="eyebrow">QUESTIONS READERS ASK</p><h2 id="faq-title">Further questions</h2>
          {insight.faqs.map((item) => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}
        </section>

        <section class="future-sources" aria-labelledby="sources-title">
          <p class="eyebrow">EVIDENCE LAYER</p><h2 id="sources-title">Sources and further reading</h2>
          <ol>{insight.sources.map((source) => <li><a href={source.url} target="_blank" rel="noreferrer"><strong>{source.name}</strong><span>{source.publisher} ↗</span></a></li>)}</ol>
          <p class="source-note">Sources support factual context. Interpretive conclusions are presented as Meysam Ghanbari’s perspective, not as settled scientific fact.</p>
        </section>
      </div>
    </div>

    <section class="shell future-author-box">
      <img src="/images/insights/meysam-ghanbari-future-systems-author.webp" alt="Meysam Ghanbari, researcher and author of Future Systems" width="1400" height="1050" loading="lazy" />
      <div><p class="eyebrow">ABOUT THE AUTHOR</p><h2>Meysam Ghanbari</h2><p>Researcher exploring advanced communications, deep technology, AI-enabled systems and the technologies and institutions that may shape the future of human civilization.</p><div class="author-links"><a href="/about">About Meysam</a><a href="/research">Research</a><a href="/contact">Contact & collaboration</a></div></div>
    </section>

    <section class="section future-related">
      <div class="shell"><div class="section-heading"><div><p class="eyebrow">CONTINUE THE SYSTEM</p><h2>Related Insights</h2></div><a class="text-link" href={`/insights/${insight.domainSlug}`}>Explore the domain →</a></div>
      <div class="future-card-grid">{related.map((item) => <a class={`future-card theme-${item.theme}`} href={`/insights/${item.slug}`}><span>{item.number} · {item.readTime}</span><h3>{item.cardTitle}</h3><p>{item.excerpt}</p><b>Read Insight →</b></a>)}</div></div>
    </section>

    <section class="future-collaboration"><div class="shell"><p class="eyebrow">RESEARCH · FORESIGHT · SYSTEMS</p><h2>Discuss a future system worth designing.</h2><p>Future-oriented research, speaking, interdisciplinary collaboration and serious technical discussions can be directed through the contact page.</p><a class="button" href="/contact">Start a conversation</a></div></section>
  </article>
</BaseLayout>
