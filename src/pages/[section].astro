---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationLibrary from '../components/PublicationLibrary.astro';
import EventCard from '../components/EventCard.astro';
import { sectionIds, site } from '../data/site';
import { projects, publications, videos, insights, upcoming, media } from '../data/library';
import { researchDomainLinks } from '../data/research-domains';
import { serializeJsonLd } from '../data/json-ld';

export function getStaticPaths() {
  return sectionIds.filter((section) => section !== 'insights').map((section) => ({ params: { section }, props: { section } }));
}

const { section } = Astro.props;
const data = site.sections.en[section];
const path = `/${section}`;
const journals = publications.filter((p) => p.type === 'Journal');
const conferences = publications.filter((p) => p.type === 'Conference');
const upcomingEvent = upcoming[0];
const upcomingSchema = {
  '@context': 'https://schema.org', '@type': 'CollectionPage',
  name: 'Upcoming presentations by Meysam Ghanbari', url: `${site.domain}/upcoming/`,
  mainEntity: { '@type':'ItemList', numberOfItems:upcoming.length,
    itemListElement:upcoming.map((event,index) => ({ '@type':'ListItem', position:index+1, name:event.title, url:`${site.domain}/events/${event.slug}/` })) }
};

const publicationPortrait = {
  image: '/images/media/meysam-ghanbari-space-communications-publications.webp',
  alt: 'AI-generated editorial portrait of Meysam Ghanbari with a conceptual Earth, satellite and research-document backdrop',
  label: 'Space, optical & quantum research',
  caption: 'AI-generated editorial portrait',
  width: 1200,
  height: 675
};
const publicationImageSchema = {
  '@type': 'ImageObject', '@id': `${site.domain}/publications/#editorial-portrait`,
  contentUrl: `${site.domain}${publicationPortrait.image}`,
  url: `${site.domain}${publicationPortrait.image}`,
  name: 'Meysam Ghanbari — communications research editorial portrait',
  description: publicationPortrait.alt, caption: publicationPortrait.caption,
  encodingFormat: 'image/webp', width: publicationPortrait.width, height: publicationPortrait.height,
  about: { '@id': `${site.domain}/#person` }
};
const publicationCollectionSchema = {
  '@context': 'https://schema.org', '@type': 'CollectionPage',
  '@id': `${site.domain}/publications/#collection`, url: `${site.domain}/publications/`,
  name: 'Meysam Ghanbari — Satellite, Optical and Quantum Communications Publications',
  description: site.sections.en.publications.intro, inLanguage: 'en',
  isPartOf: { '@id': `${site.domain}/#website` }, about: { '@id': `${site.domain}/#person` },
  primaryImageOfPage: publicationImageSchema,
  mainEntity: {
    '@type': 'ItemList', name: 'Journal and conference publications',
    numberOfItems: publications.length,
    itemListElement: publications.map((paper, index) => ({
      '@type': 'ListItem', position: index + 1,
      name: paper.title, url: `${site.domain}/publications/${paper.slug}/`
    }))
  }
};

const sectionVisuals = {
  research: { image: '/images/records/deep-space-optical-communications-photorealistic.webp', label: 'Optical links across space', width: 1672, height: 941 },
  projects: { image: '/images/records/optical-precision-tracking-photorealistic.webp', label: 'Optical terminal engineering', width: 1672, height: 941 },
  publications: publicationPortrait,
  videos: { image: '/images/media/meysam-ghanbari-research-presentation.webp', label: 'Presentations and talks', width: 1672, height: 941 },
  insights: { image: '/images/profile/meysam-ghanbari-satellite-optical-communications.webp', label: 'Technical perspectives', width: 1122, height: 1402 },
  upcoming: { image: upcomingEvent?.image ?? '/images/media/meysam-ghanbari-research-presentation.webp', label: upcomingEvent ? `${upcomingEvent.shortName} · ${upcomingEvent.location}` : 'Upcoming presentations', width: upcomingEvent?.imageWidth ?? 1280, height: upcomingEvent?.imageHeight ?? 720 },
  media: { image: '/images/profile/meysam-ghanbari-formal-portrait.webp', label: 'Media library', width: 1024, height: 1536 },
  about: { image: '/images/profile/meysam-ghanbari-professional-headshot.webp', label: 'Research profile', width: 1086, height: 1448 },
  contact: { image: '/images/media/meysam-ghanbari-research-workspace.webp', label: 'Research enquiries', width: 1672, height: 941 }
} as const;

const visual = sectionVisuals[section];
---

<BaseLayout
  title={data.title}
  description={section === 'upcoming' && upcomingEvent ? `Upcoming research presentations by Meysam Ghanbari: ${upcoming.map(event => `${event.shortName} in ${event.location}`).join('; ')}. Explore the research questions and official event details.` : data.intro}
  lang="en"
  path={path}
  seoTitle={section === 'publications' ? 'Satellite, Optical & Quantum Communications Publications | Meysam Ghanbari' : section === 'upcoming' ? 'Upcoming International Research Presentations | Meysam Ghanbari' : undefined}
  image={section === 'publications' ? publicationPortrait.image : section === 'upcoming' && upcomingEvent ? upcomingEvent.image : undefined}
  imageAlt={section === 'publications' ? publicationPortrait.alt : section === 'upcoming' && upcomingEvent ? upcomingEvent.imageAlt : undefined}
>
  <Fragment slot="head">
    {section === 'upcoming' && <script type="application/ld+json" set:html={serializeJsonLd(upcomingSchema)}></script>}
    {section === 'publications' && <>
      <script type="application/ld+json" set:html={serializeJsonLd(publicationCollectionSchema)}></script>
      <meta property="og:image:width" content={String(publicationPortrait.width)} />
      <meta property="og:image:height" content={String(publicationPortrait.height)} />
      <meta name="twitter:image:alt" content={publicationPortrait.alt} />
    </>}
  </Fragment>
  
{section === 'upcoming' ? <section class="international-hero">
  <div class="international-portrait-background" aria-hidden="true">
    <img src="/images/profile/meysam-ghanbari-upcoming-editorial-background.webp" alt="" width="1536" height="864" loading="eager" decoding="async" />
  </div>
  <div class="shell">
    <p class="eyebrow">INTERNATIONAL RESEARCH APPEARANCES</p>
    <h1>Upcoming<br />international appearances</h1>
    <p class="international-intro">Meysam Ghanbari’s forthcoming conference presentations bring space and optical communications research to international audiences in Jordan, Spain, Morocco and Germany.</p>
    <nav class="destination-index" aria-label="Upcoming conference destinations">
      {upcoming.map((event,index) => <a href={`#${event.slug}`} class:list={['destination-tile', { 'destination-poster': event.imageKind === 'official-conference' }]}>
        <img src={event.imageSmall ?? event.image} alt={event.imageAlt} width={event.imageWidth} height={event.imageHeight} loading={index === 0 ? 'eager' : 'lazy'} fetchpriority={index === 0 ? 'high' : 'auto'} />
        <div><strong>{event.country}</strong><span>{event.city} · {event.shortName}</span><small>{event.date}</small></div>
      </a>)}
    </nav>
  </div>
</section> : <section class={`page-hero page-hero-space page-hero-${section}`}>
  <div class="space-grid-bg" aria-hidden="true"></div>
  <div class="page-hero-backdrop" style={`background-image:url('${visual.image}')`}></div>
  <div class="page-hero-orbit" aria-hidden="true"></div>
  <div class="shell page-hero-shell">
    <div class="page-hero-copy narrow">
      <p class="eyebrow">{data.kicker}</p>
      <h1>{data.title}</h1>
      <p class="page-intro">{data.intro}</p>
    </div>
    {section === 'publications' ? <figure class="page-hero-sidecard publication-hero-portrait">
      <img src={publicationPortrait.image}
        srcset="/images/media/meysam-ghanbari-space-communications-publications-640.webp 640w, /images/media/meysam-ghanbari-space-communications-publications-960.webp 960w, /images/media/meysam-ghanbari-space-communications-publications.webp 1200w"
        sizes="(max-width: 600px) calc(100vw - 40px), 520px"
        alt={publicationPortrait.alt} width={publicationPortrait.width} height={publicationPortrait.height}
        loading="eager" fetchpriority="high" aria-describedby="publication-portrait-caption" />
      <figcaption class="publication-portrait-caption" id="publication-portrait-caption">
        <span>{publicationPortrait.label}</span>
      </figcaption>
    </figure> : <div class="page-hero-sidecard">
      <img src={visual.image} alt={visual.label} width={visual.width} height={visual.height} loading="eager" />
      <div>
        <span>{visual.label}</span>
        <small>{site.name}</small>
      </div>
    </div>}
  </div>
</section>}

  {section === 'research' && (
    <section class="section section-tight">
      <div class="shell">
        <a class="research-record-feature" href="/research/optical-communications-records/">
          <div class="research-record-copy">
            <span>NEW · TECHNICAL OBSERVATORY</span>
            <h2>Optical & Satellite Communications Record Observatory</h2>
            <p>Explore verified speed, range, tracking, relay, quantum-link and optical-power milestones—with the engineering method, project context and primary evidence behind every number.</p>
            <div><strong>200 Gbit/s</strong><strong>460M km</strong><strong>30 ps</strong><strong>&gt;800 W</strong></div>
            <b>Open the record observatory ↗</b>
          </div>
          <img src="/images/records/optical-record-observatory-photorealistic.webp" alt="Photorealistic panorama of optical communication links across Earth orbit, lunar distance and deep space" width="1672" height="941" loading="eager" />
        </a>
        <div class="domain-grid research-domain-grid">
          {site.themes.en.map(([title, text], i) => (
            <article class={`domain-card domain-card-${(i % 4) + 1}`}>
              <span class="domain-index">0{i + 1}</span>
              <h2>{title}</h2>
              <p>{text}</p>
              <div class="domain-links">
                {researchDomainLinks[i].project && <a href={`/projects/${researchDomainLinks[i].project}/`}>Related project →</a>}
                <a href={`/publications/${researchDomainLinks[i].publication}/`}>Related publication →</a>
              </div>
            </article>
          ))}
        </div>
        <div class="expertise-panel">
          <div>
            <p class="eyebrow">TECHNICAL PROFILE</p>
            <h2>Analytical modeling, receiver design and communication-system implementation</h2>
          </div>
          <div class="expertise-list">
            <span>Link budgets & Gaussian-beam propagation</span>
            <span>Receiver noise & sensitivity</span>
            <span>Photodetector / TIA interfaces</span>
            <span>Pointing error & jitter</span>
            <span>Acquisition, alignment & fine tracking</span>
            <span>BER / SER / outage modeling</span>
            <span>Monte Carlo simulation & optimization</span>
            <span>MATLAB · Python · C · FPGA</span>
          </div>
        </div>
      </div>
    </section>
  )}

  {section === 'projects' && (
    <section class="section section-tight">
      <div class="shell">
        <div class="project-portfolio-grid project-index-grid">
          {projects.en.map((project) => (
            <a class="project-portfolio-card" href={project.href}>
              <div class="project-card-top"><span>{project.number}</span><span>{project.status}</span></div>
              <p class="tag">{project.category}</p>
              <h2>{project.title}</h2>
              <p>{project.summary}</p>
              <div class="project-meta">
                {project.tags.map((tag) => <span>{tag}</span>)}
              </div>
              <span class="project-explore">Explore project <b>↗</b></span>
            </a>
          ))}
        </div>
        <div class="knowledge-graph-note"><span>RESEARCH GRAPH</span><p>Every project connects to its related publications and research domains, creating a navigable technical record rather than an isolated portfolio card.</p></div>
      </div>
    </section>
  )}

  {section === 'publications' && <PublicationLibrary />}

  {section === 'videos' && (
    <section class="section section-tight">
      <div class="shell">
        {videos.length === 0 ? (
          <div class="talk-library-empty">
            <div class="talk-stage">
              <img src="/images/media/meysam-ghanbari-research-presentation.webp" alt="Meysam Ghanbari during a professional research presentation" width="1672" height="941" loading="eager" />
              <span>PUBLIC MEDIA ARCHIVE</span>
            </div>
            <div>
              <p class="eyebrow">PRESENTATIONS & TALKS</p>
              <h2>Research made visible.</h2>
              <p>Public video recordings will appear here when available. The upcoming conference presentation is listed separately with its research question and event details.</p>
              {upcomingEvent && <a class="talk-upcoming-link" href="/upcoming/"><span>UPCOMING · {upcomingEvent.conference}</span><strong>{upcomingEvent.paperTitle}</strong><b>View presentation details →</b></a>}
              <a class="button ghost" href="/contact">Speaking & presentation enquiries</a>
            </div>
          </div>
        ) : (
          <div class="card-grid three">
            {videos.map((video) => <article class="card"><h2>{video.title}</h2></article>)}
          </div>
        )}
      </div>
    </section>
  )}

  {section === 'insights' && (
    <section class="section section-tight">
      <div class="shell">
        {insights.length === 0 ? (
          <div>
            <div class="insight-intro"><p class="eyebrow">KNOWLEDGE PLATFORM</p><h2>Technical insight without filler.</h2><p>No insight articles have been published yet. When added, they will translate real research questions into rigorous, accessible explanations—not generic commentary.</p></div>
            <div class="insight-category-grid">
              {['Optical Communications', 'Space Networks', 'Quantum Systems', 'AI for Communications', '6G / NTN', 'Research Commentary'].map((category, index) => (
                <article><span>0{index + 1}</span><h3>{category}</h3><p>Future verified analysis and research explainers.</p></article>
              ))}
            </div>
          </div>
        ) : (
          <div class="card-grid three">
            {insights.map((item) => <article class="card"><h2>{item.title}</h2><p>{item.excerpt}</p></article>)}
          </div>
        )}
      </div>
    </section>
  )}

  {section === 'upcoming' && (
    <section class="section section-tight">
      <div class="shell">
        {upcoming.length === 0 ? (
          <div class="upcoming-empty upcoming-system">
            <div class="upcoming-orbit" aria-hidden="true"></div>
            <p class="eyebrow">PUBLIC SCHEDULE</p>
            <h2>No confirmed public appearances are currently listed.</h2>
            <p>Confirmed events and planned or prospective activity are kept separate. Nothing is presented as attendance or participation before it is verified.</p>
            <div class="status-legend"><span><i class="confirmed"></i>Confirmed</span><span><i class="planned"></i>Planned / prospective</span><span><i class="completed"></i>Completed</span></div>
            <a class="button ghost" href="/contact">Send an invitation</a>
          </div>
        ) : (
          <div class="upcoming-list">
            {upcoming.map(item => <EventCard item={item} />)}
            <div class="event-related-links">
              <a href="/publications/"><span>PUBLICATIONS</span><strong>Explore the papers behind the presentations</strong><small>Original abstracts, technical explanations and citations →</small></a>
              <a href="/videos/"><span>TALKS & VIDEO</span><strong>Research communication and recordings</strong><small>Explore Talks & Video →</small></a>
              <a href="/contact/"><span>RESEARCH DISCUSSION</span><strong>Discuss space, optical and quantum communications</strong><small>Contact Meysam →</small></a>
            </div>
          </div>
        )}
      </div>
    </section>
  )}

  {section === 'media' && (
    <section class="section section-tight">
      <div class="shell">
        <div class="media-grid-v2">
          {media.map((item, i) => (
            <figure class={`media-card media-card-${i + 1}`}>
              <img src={item.src} alt={item.alt} width={i < 2 ? 1122 : i < 4 ? 1672 : i === 4 ? 1024 : 1086} height={i < 2 ? 1402 : i < 4 ? 941 : i === 4 ? 1536 : 1448} loading={i < 2 ? 'eager' : 'lazy'} />
              <figcaption>{item.labelEn}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  {section === 'about' && (
    <section class="section section-tight">
      <div class="shell about-grid about-grid-v2">
        <div class="about-visual">
          <img class="about-portrait" src="/images/profile/meysam-ghanbari-satellite-optical-communications.webp" alt="Meysam Ghanbari in a satellite and optical communications research environment" width="1122" height="1402" loading="lazy" />
        </div>
        <div class="prose">
          <p class="eyebrow">IDENTITY</p>
          <h2>Research at the intersection of light, space and intelligent networks.</h2>
          <p>Meysam Ghanbari is a researcher and communication-systems engineer working across optical and satellite communications. His research connects theoretical performance analysis with receiver architecture, beam-control constraints and emerging non-terrestrial networks.</p>

          <h2>Research direction</h2>
          <p>Current work examines how highly directional links can be made more robust, efficient and operationally useful—from inter-satellite optical relaying and integrated receivers to quantum timing, terahertz coverage and AI-assisted sensing.</p>

          <h2>Technical expertise</h2>
          <ul>
            <li>Inter-satellite optical links and optical satellite communications</li>
            <li>Free-space optical and non-terrestrial communication systems</li>
            <li>Optical receiver architecture, sensitivity and TIA interfaces</li>
            <li>Pointing, acquisition, alignment and fine tracking</li>
            <li>Quantum optical communication links</li>
            <li>Analytical modeling, Monte Carlo simulation and physics-based digital twins</li>
          </ul>

          <h2>Research philosophy</h2>
          <p>The work is organized around a systems question: how should propagation, optics, detectors, algorithms and network behavior be designed together rather than optimized in isolation? Analytical derivation, simulation and implementation-aware modeling are used to keep proposed architectures technically interpretable.</p>

          <h2>Future direction</h2>
          <p>The long-term direction is toward advanced communication systems that bridge academic research and deep-tech engineering across space communications, photonics, quantum infrastructure and intelligent networks.</p>

          <div class="milestone-grid"><div><strong>Optical systems</strong><span>Links, receivers and tracking</span></div><div><strong>Network scale</strong><span>Satellite, aerial and city-scale systems</span></div><div><strong>Methods</strong><span>Analysis, simulation and AI</span></div></div>

          <div class="about-actions">
            <a class="button" href="/publications">Publication library</a>
            <a class="button ghost" href="/contact">Research enquiries</a>
            {site.socialLinks.linkedin && <a class="button ghost" href={site.socialLinks.linkedin} target="_blank" rel="me noreferrer">LinkedIn ↗</a>}
          </div>
        </div>
      </div>
    </section>
  )}

  {section === 'contact' && (
    <section class="section section-tight">
      <div class="shell contact-layout">
        <div class="contact-paths">
          <p class="eyebrow">START WITH THE RIGHT PATH</p>
          <h2>Serious enquiries, clearly routed.</h2>
          <p>Share the technical context, organization and intended form of collaboration. Messages remain concise and go directly to Meysam Ghanbari.</p>
          <div class="contact-path-grid">
            <div><strong>Research collaboration</strong><span>Joint studies, papers and research visits</span></div>
            <div><strong>Industry & R&D</strong><span>Optical, satellite and advanced communication challenges</span></div>
            <div><strong>Technical consultation</strong><span>System modeling, architecture and analysis</span></div>
            <div><strong>Speaking & media</strong><span>Presentations, interviews and technical discussion</span></div>
          </div>
          <a class="direct-email" href={`mailto:${site.contactEmail}`}><small>DIRECT EMAIL</small><strong>{site.contactEmail}</strong><span>↗</span></a>
          {site.socialLinks.linkedin && <a class="direct-email" href={site.socialLinks.linkedin} target="_blank" rel="me noreferrer"><small>PROFESSIONAL PROFILE</small><strong>LinkedIn</strong><span>↗</span></a>}
        </div>

        <form class="enquiry-form" data-enquiry-form data-email={site.contactEmail}>
          <div class="form-head"><span>STRUCTURED ENQUIRY</span><small>All fields except organization are required</small></div>
          <label>Name<input type="text" name="name" autocomplete="name" required /></label>
          <label>Email<input type="email" name="email" autocomplete="email" required /></label>
          <label>Organization / University<input type="text" name="organization" autocomplete="organization" /></label>
          <label>Area of Interest<input type="text" name="area" placeholder="e.g. inter-satellite optical links" required /></label>
          <label>Type of Request
            <select name="requestType" required>
              <option value="">Select a request type</option>
              <option>Research Collaboration</option><option>Technical Consultation</option><option>Project Guidance</option><option>Industrial R&D</option><option>Visiting Research</option><option>Speaking / Presentation</option><option>Other</option>
            </select>
          </label>
          <label>Message<textarea name="message" rows="6" required></textarea></label>
          <button class="button" type="submit">Prepare enquiry email</button>
          <p class="form-note">This opens the visitor’s email application with the structured message prepared for review before sending.</p>
        </form>
      </div>
      <script>
        const form = document.querySelector<HTMLFormElement>('[data-enquiry-form]');
        form?.addEventListener('submit', (event) => {
          event.preventDefault();
          const data = new FormData(form);
          const recipient = form.getAttribute('data-email');
          const subject = `${data.get('requestType')} enquiry — ${data.get('area')}`;
          const body = `Name: ${data.get('name')}\nEmail: ${data.get('email')}\nOrganization / University: ${data.get('organization') || 'Not provided'}\nArea of Interest: ${data.get('area')}\nType of Request: ${data.get('requestType')}\n\nMessage:\n${data.get('message')}`;
          window.location.href = `mailto:${recipient}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
        });
      </script>
    </section>
  )}
</BaseLayout>

<style>
.international-hero { position:relative; isolation:isolate; padding:55px 0 48px; border-bottom:1px solid var(--line); background:#07111e; }
.international-portrait-background { position:absolute; inset:0; z-index:-1; overflow:hidden; pointer-events:none; }
.international-portrait-background img { position:absolute; top:-32px; right:max(0px,calc((100% - 1440px)/2)); width:min(100%,1000px); max-width:none; height:auto; opacity:.88; }
.international-portrait-background::after { content:''; position:absolute; inset:0; background:linear-gradient(90deg,#07111e 0%,#07111ef2 35%,#07111e9c 60%,#07111e24 82%,#07111e60),linear-gradient(180deg,#07111e10 0%,#07111e12 36%,#07111eeb 72%,#07111e 90%); }
@media(max-width:900px) { .international-portrait-background img { top:0; opacity:.5; } .international-portrait-background::after { background:linear-gradient(90deg,#07111ed9,#07111e99),linear-gradient(180deg,#07111e10,#07111e 340px); } }
.international-hero h1 { max-width:1000px; font-size:clamp(34px,4.5vw,64px); line-height:1.08; letter-spacing:-.04em; margin:18px 0 24px; }
.international-intro { max-width:820px; color:#c1d2e1; font-size:17px; line-height:1.8; margin:0 0 34px; }
.destination-index { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:16px; }
.destination-tile { min-width:0; border:1px solid #284358; border-radius:4px; overflow:hidden; background:#0b1a2a; transition:border-color .2s ease; }
.destination-tile:hover,.destination-tile:focus-visible { border-color:#90deef; }
.destination-tile img { display:block; width:100%; height:auto; aspect-ratio:16/9; object-fit:cover; }
.destination-poster img { object-fit:contain; background:#07111e; }
.destination-tile div { padding:18px 16px; }
.destination-tile strong,.destination-tile span,.destination-tile small { display:block; }
.destination-tile strong { font-size:25px; letter-spacing:-.02em; line-height:1.2; }
.destination-tile span { margin-top:9px; color:#c2d5e5; font-size:11px; line-height:1.6; }
.destination-tile small { margin-top:7px; color:#99bfd0; font-size:10px; line-height:1.6; }
@media(max-width:900px) { .destination-index { grid-template-columns:repeat(2,minmax(0,1fr)); } .international-hero { padding-top:36px; } }
@media(max-width:380px) { .destination-index { gap:10px; } .destination-tile div { padding:14px 10px; } .destination-tile strong { font-size:21px; } }

.page-hero-upcoming .page-hero-sidecard img { object-fit:contain; height:auto; width:100%; }
.upcoming-list { display:grid; gap:28px; }
</style>
