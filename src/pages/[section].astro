---
import BaseLayout from '../layouts/BaseLayout.astro';
import { sectionIds, site } from '../data/site';
import { projects, publications, videos, insights, upcoming, media } from '../data/library';

export function getStaticPaths() {
  return sectionIds.map((section) => ({ params: { section }, props: { section } }));
}

const { section } = Astro.props;
const data = site.sections.en[section];
const path = `/${section}`;
const journals = publications.filter((p) => p.type === 'Journal');
const conferences = publications.filter((p) => p.type === 'Conference');

const sectionVisuals = {
  research: { image: '/images/profile/meysam-ghanbari-space-communications-researcher.webp', label: 'Orbital research systems' },
  projects: { image: '/images/profile/meysam-ghanbari-satellite-optical-communications.webp', label: 'Engineering directions' },
  publications: { image: '/images/profile/meysam-ghanbari-space-communications-researcher.webp', label: 'Publication library' },
  videos: { image: '/images/media/meysam-ghanbari-research-presentation.webp', label: 'Presentations and talks' },
  insights: { image: '/images/profile/meysam-ghanbari-satellite-optical-communications.webp', label: 'Technical perspectives' },
  upcoming: { image: '/images/media/meysam-ghanbari-research-presentation.webp', label: 'Upcoming appearances' },
  media: { image: '/images/profile/meysam-ghanbari-formal-portrait.webp', label: 'Media library' },
  about: { image: '/images/profile/meysam-ghanbari-professional-headshot.webp', label: 'Research profile' },
  contact: { image: '/images/media/meysam-ghanbari-research-workspace.webp', label: 'Research enquiries' }
} as const;

const visual = sectionVisuals[section];
---

<BaseLayout title={data.title} description={data.intro} lang="en" path={path}>
  
<section class={`page-hero page-hero-space page-hero-${section}`}>
  <div class="space-grid-bg" aria-hidden="true"></div>
  <div class="page-hero-backdrop" style={`background-image:url('${visual.image}')`}></div>
  <div class="page-hero-orbit" aria-hidden="true"></div>
  <div class="shell page-hero-shell">
    <div class="page-hero-copy narrow">
      <p class="eyebrow">{data.kicker}</p>
      <h1>{data.title}</h1>
      <p class="page-intro">{data.intro}</p>
    </div>
    <div class="page-hero-sidecard">
      <img src={visual.image} alt={visual.label} loading="eager" />
      <div>
        <span>{visual.label}</span>
        <small>{site.name}</small>
      </div>
    </div>
  </div>
</section>

  {section === 'research' && (
    <section class="section section-tight">
      <div class="shell">
        <div class="card-grid research-grid">
          {site.themes.en.map(([title, text], i) => (
            <article class="card research-card">
              <span class="card-index">0{i + 1}</span>
              <h2>{title}</h2>
              <p>{text}</p>
            </article>
          ))}
        </div>
        <div class="expertise-panel">
          <div>
            <p class="eyebrow">TECHNICAL PROFILE</p>
            <h2>Analytical modeling, receiver design and communication-system implementation</h2>
          </div>
          <div class="expertise-list">
            <span>Link budgets & Gaussian-beam propagation</span>
            <span>Receiver noise & sensitivity</span>
            <span>Photodetector / TIA interfaces</span>
            <span>Pointing error & jitter</span>
            <span>Acquisition, alignment & fine tracking</span>
            <span>BER / SER / outage modeling</span>
            <span>Monte Carlo simulation & optimization</span>
            <span>MATLAB · Python · C · FPGA</span>
          </div>
        </div>
      </div>
    </section>
  )}

  {section === 'projects' && (
    <section class="section section-tight">
      <div class="shell">
        <div class="card-grid two project-detail-grid">
          {projects.en.map((project, i) => (
            <article class="card project-card project-card-large">
              <span class="card-index">0{i + 1}</span>
              <p class="tag">{project.tag}</p>
              <h2>{project.title}</h2>
              <p>{project.summary}</p>
              <div class="project-meta">
                <span>Architecture</span><span>Analysis</span><span>Simulation</span><span>Publication</span>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  {section === 'publications' && (
    <section class="section section-tight">
      <div class="shell">
        <div class="publication-group">
          <div class="group-heading"><span>JOURNALS</span><strong>{journals.length}</strong></div>
          <div class="publication-list">
            {journals.map((paper) => (
              <a class="publication-row publication-link" href={`/publications/${paper.slug}`}>
                <div>
                  <p class="tag">{paper.year} · {paper.status}</p>
                  <h2>{paper.title}</h2>
                  <p>{paper.authors}</p>
                  <p>{paper.venue}</p>
                </div>
                <span class="publication-arrow">↗</span>
              </a>
            ))}
          </div>
        </div>

        <div class="publication-group">
          <div class="group-heading"><span>CONFERENCES</span><strong>{conferences.length}</strong></div>
          <div class="publication-list">
            {conferences.map((paper) => (
              <a class="publication-row publication-link" href={`/publications/${paper.slug}`}>
                <div>
                  <p class="tag">{paper.year} · {paper.status}</p>
                  <h2>{paper.title}</h2>
                  <p>{paper.authors}</p>
                  <p>{paper.venue}</p>
                </div>
                <span class="publication-arrow">↗</span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>
  )}

  {section === 'videos' && (
    <section class="section section-tight">
      <div class="shell">
        {videos.length === 0 ? (
          <div class="empty-state">
            <span class="empty-icon">▶</span>
            <h2>No public videos listed</h2>
            <p>Research presentations and technical media will be listed when publicly available.</p>
          </div>
        ) : (
          <div class="card-grid three">
            {videos.map((video) => <article class="card"><h2>{video.title}</h2></article>)}
          </div>
        )}
      </div>
    </section>
  )}

  {section === 'insights' && (
    <section class="section section-tight">
      <div class="shell">
        {insights.length === 0 ? (
          <div class="empty-state insight-empty">
            <span class="empty-icon">✦</span>
            <h2>Perspectives</h2>
            <p>No technical perspectives have been published yet.</p>
          </div>
        ) : (
          <div class="card-grid three">
            {insights.map((item) => <article class="card"><h2>{item.title}</h2><p>{item.excerpt}</p></article>)}
          </div>
        )}
      </div>
    </section>
  )}

  {section === 'upcoming' && (
    <section class="section section-tight">
      <div class="shell">
        {upcoming.length === 0 ? (
          <div class="upcoming-empty">
            <div class="upcoming-orbit" aria-hidden="true"></div>
            <p class="eyebrow">CALENDAR</p>
            <h2>No upcoming public appearances are currently listed.</h2>
            <p>For invitations, research visits or speaking enquiries, please use the contact page.</p>
            <a class="button ghost" href="/contact">Send an invitation</a>
          </div>
        ) : (
          <div class="timeline">
            {upcoming.map((item) => (
              <article class="timeline-item">
                <span>{item.date}</span><h2>{item.title}</h2><p>{item.type} · {item.location}</p>
              </article>
            ))}
          </div>
        )}
      </div>
    </section>
  )}

  {section === 'media' && (
    <section class="section section-tight">
      <div class="shell">
        <div class="media-grid-v2">
          {media.map((item, i) => (
            <figure class={`media-card media-card-${i + 1}`}>
              <img src={item.src} alt={item.alt} loading={i < 2 ? 'eager' : 'lazy'} />
              <figcaption>{item.labelEn}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  {section === 'about' && (
    <section class="section section-tight">
      <div class="shell about-grid about-grid-v2">
        <div class="about-visual">
          <img class="about-portrait" src="/images/profile/meysam-ghanbari-satellite-optical-communications.webp" alt="Meysam Ghanbari in a satellite and optical communications research environment" />
        </div>
        <div class="prose">
          <p class="eyebrow">PROFILE</p>
          <h2>Satellite, optical and advanced communication systems</h2>
          <p>Meysam Ghanbari is a researcher and engineer working across optical and satellite communications, with emphasis on inter-satellite optical links, free-space optical systems, receiver architecture and beam-control problems.</p>
          <p>His technical work includes end-to-end analytical and Monte Carlo modeling for link budgets, receiver noise, beam propagation, alignment, BER/SER and outage, alongside FPGA development, MATLAB/Python/C, physics-based digital twins and industrial automation.</p>

          <h2>Current research focus</h2>
          <ul>
            <li>Inter-satellite optical links and optical satellite communications</li>
            <li>Free-space optical and non-terrestrial communication systems</li>
            <li>Optical receiver architecture, sensitivity and TIA interfaces</li>
            <li>Pointing, acquisition, alignment and fine tracking</li>
            <li>Quantum optical communication links</li>
            <li>Analytical modeling, Monte Carlo simulation and physics-based digital twins</li>
          </ul>

          <h2>Engineering background</h2>
          <p>Additional engineering experience includes FPGA and digital systems, signal-processing implementation, PSpice and Proteus, Siemens PLC programming, SCL, STEP 7, WinCC and Siemens Twin Builder.</p>

          <div class="about-actions">
            <a class="button" href="/publications">Publication library</a>
            <a class="button ghost" href="/contact">Research enquiries</a>
          </div>
        </div>
      </div>
    </section>
  )}

  {section === 'contact' && (
    <section class="section section-tight">
      <div class="shell contact-grid">
        <a class="contact-card" href={`mailto:${site.contactEmail}`}>
          <span class="tag">DIRECT EMAIL</span>
          <h2>{site.contactEmail}</h2>
          <p>For research collaboration, industry R&D, technical consulting, speaking, media and deep-tech enquiries.</p>
          <span class="text-link">Send email →</span>
        </a>
        <div class="contact-card contact-photo-card">
          <img src="/images/media/meysam-ghanbari-research-workspace.webp" alt="Meysam Ghanbari working at a research desk" loading="lazy" />
          <div class="contact-photo-copy">
            <span class="tag">ENQUIRY TYPES</span>
            <p>Research collaboration · Industry R&D · Technical consulting · Speaking · Media · Deep-tech opportunities</p>
          </div>
        </div>
      </div>
    </section>
  )}
</BaseLayout>
