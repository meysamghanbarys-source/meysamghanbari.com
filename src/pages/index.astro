
---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { publications } from '../data/library';

const c = site.home.en;
const featured = publications.slice(0, 4);
---

<BaseLayout
  title={site.name}
  description="Official research website of Meysam Ghanbari, focused on optical, satellite and advanced communication systems."
  lang="en"
  path="/"
  image={site.heroImage}
>
  <section class="hero hero-space hero-space-clean">
    <div class="hero-space-bg" style={`background-image:url('${site.heroImage}')`}></div>
    <div class="hero-space-overlay"></div>
    <div class="orbit-lines orbit-lines-animated" aria-hidden="true"></div>
    <div class="hero-stars" aria-hidden="true"></div>
    <div class="hero-planet hero-planet-main" aria-hidden="true"></div>
    <div class="shell hero-grid hero-grid-space hero-grid-clean">
      <div class="hero-copy hero-copy-clean">
        <p class="eyebrow">{c.eyebrow}</p>
        <h1>{site.name}</h1>
        <p class="role">{site.role.en}</p>
        <h2>{c.headline}</h2>
        <p class="lede lede-compact">{c.intro}</p>
        <div class="hero-actions">
          <a class="button" href="/research">Research</a>
          <a class="button ghost" href="/publications">Publications</a>
          <a class="button ghost" href="/contact">Contact</a>
        </div>
        <div class="signal-row" aria-label="Research focus">
          <span>OISL</span><span>FSO</span><span>Receiver Systems</span><span>PAT</span><span>Quantum</span>
        </div>
      </div>

      <div class="hero-profile-card hero-profile-card-clean">
        <img
          src="/images/profile/meysam-ghanbari-formal-portrait.webp"
          alt="Formal portrait of Meysam Ghanbari"
          loading="eager"
          fetchpriority="high"
        />
        <div class="hero-profile-caption">
          <span>MEYSAM GHANBARI</span>
          <small>Optical · Satellite · Deep-Tech Communications</small>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-home-panels">
    <div class="shell home-panels-grid">
      <a class="home-panel home-panel-research" href="/research">
        <span class="tag">RESEARCH</span>
        <h3>Optical and satellite systems</h3>
        <p>Receiver architecture, OISL, FSO, PAT and non-terrestrial communications.</p>
      </a>
      <a class="home-panel home-panel-publications" href="/publications">
        <span class="tag">PUBLICATIONS</span>
        <h3>Journal and conference work</h3>
        <p>A structured publication library with dedicated paper pages and summaries.</p>
      </a>
      <a class="home-panel home-panel-insights" href="/insights">
        <span class="tag">INSIGHTS</span>
        <h3>Future-facing technical perspectives</h3>
        <p>Ideas on advanced communications, photonics, space systems and deep-tech directions.</p>
      </a>
    </div>
  </section>

  <section class="section section-muted">
    <div class="shell">
      <div class="section-heading split-heading">
        <div>
          <p class="eyebrow">FEATURED PUBLICATIONS</p>
          <h2>Selected work</h2>
        </div>
        <p>Representative papers across optical links, intelligent communication systems and satellite communications.</p>
      </div>
      <div class="publication-list">
        {featured.map((paper) => (
          <a class="publication-row publication-link" href={`/publications/${paper.slug}`}>
            <div>
              <p class="tag">{paper.type} · {paper.year} · {paper.status}</p>
              <h3>{paper.title}</h3>
              <p>{paper.venue}</p>
            </div>
            <span class="publication-arrow">↗</span>
          </a>
        ))}
      </div>
      <a class="text-link large-link" href="/publications">View publication library →</a>
    </div>
  </section>

  <section class="section section-collaboration">
    <div class="shell collaboration-card">
      <div>
        <p class="eyebrow">ENQUIRIES</p>
        <h2>Research, advisory and speaking enquiries</h2>
        <p>For collaborations, technical discussions, consulting, speaking invitations and industry opportunities, please use the contact page.</p>
      </div>
      <a class="button light" href="/contact">Contact</a>
    </div>
  </section>
</BaseLayout>
