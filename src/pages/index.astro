---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { projects, publications } from '../data/library';

const c = site.home.en;
const featured = publications.slice(0, 5);
---

<BaseLayout
  title={site.name}
  description="Official research website of Meysam Ghanbari, focused on optical, satellite and advanced communication systems."
  lang="en"
  path="/"
  image={site.heroImage}
>
  <section class="hero hero-space">
    <div class="hero-space-bg" style={`background-image:url('${site.heroImage}')`}></div>
    <div class="hero-space-overlay"></div>
    <div class="orbit-lines" aria-hidden="true"></div>
    <div class="shell hero-grid hero-grid-space">
      <div class="hero-copy">
        <p class="eyebrow">{c.eyebrow}</p>
        <h1>{site.name}</h1>
        <p class="role">{site.role.en}</p>
        <h2>{c.headline}</h2>
        <p class="lede">{c.intro}</p>
        <div class="hero-actions">
          <a class="button" href="/research">{c.primaryCta}</a>
          <a class="button ghost" href="/contact">{c.secondaryCta}</a>
          <a class="button ghost" href={site.cvUrl} target="_blank" rel="noreferrer">View CV</a>
        </div>
        <div class="signal-row" aria-label="Research focus">
          <span>OISL</span><span>FSO</span><span>Receiver Design</span><span>PAT</span><span>NTN</span><span>Quantum</span>
        </div>
      </div>

      <div class="hero-profile-card">
        <img
          src="/images/profile/meysam-ghanbari-formal-portrait.webp"
          alt="Formal portrait of Meysam Ghanbari"
          loading="eager"
          fetchpriority="high"
        />
        <div class="hero-profile-caption">
          <span>MEYSAM GHANBARI</span>
          <small>Optical · Satellite · Advanced Communications</small>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section-heading">
        <p class="eyebrow">RESEARCH</p>
        <h2>{c.researchTitle}</h2>
        <p>{c.researchIntro}</p>
      </div>
      <div class="card-grid research-grid">
        {site.themes.en.map(([title, text], i) => (
          <article class="card research-card">
            <span class="card-index">0{i + 1}</span>
            <h3>{title}</h3>
            <p>{text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-visual-break">
    <div class="shell visual-break-grid">
      <div class="visual-break-image">
        <img src="/images/profile/meysam-ghanbari-satellite-optical-communications.webp" alt="Meysam Ghanbari in a satellite and optical communications technology environment" loading="lazy" />
      </div>
      <div class="visual-break-copy">
        <p class="eyebrow">SATELLITE · OPTICAL · DEEP TECH</p>
        <h2>Research positioned around systems that can move from analysis toward engineering implementation.</h2>
        <p>The portfolio combines analytical modeling, simulation, receiver design, beam-control problems, photonic concepts and data-driven communication-system methods.</p>
        <a class="text-link large-link" href="/projects">Explore projects →</a>
      </div>
    </div>
  </section>

  <section class="section section-muted">
    <div class="shell">
      <div class="section-heading split-heading">
        <div>
          <p class="eyebrow">ENGINEERING</p>
          <h2>{c.projectTitle}</h2>
        </div>
        <p>{c.projectIntro}</p>
      </div>
      <div class="card-grid four">
        {projects.en.map((project) => (
          <article class="card project-card">
            <p class="tag">{project.tag}</p>
            <h3>{project.title}</h3>
            <p>{project.summary}</p>
            <a class="text-link" href={project.href}>Project portfolio →</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section-heading split-heading">
        <div>
          <p class="eyebrow">PUBLICATIONS</p>
          <h2>{c.publicationTitle}</h2>
        </div>
        <p>{c.publicationIntro}</p>
      </div>
      <div class="publication-list">
        {featured.map((paper) => (
          <a class="publication-row publication-link" href={`/publications/${paper.slug}`}>
            <div>
              <p class="tag">{paper.type} · {paper.year} · {paper.status}</p>
              <h3>{paper.title}</h3>
              <p>{paper.venue}</p>
            </div>
            <span class="publication-arrow">↗</span>
          </a>
        ))}
      </div>
      <a class="text-link large-link" href="/publications">View complete publication library →</a>
    </div>
  </section>

  <section class="section media-strip-section">
    <div class="shell media-strip">
      <img src="/images/media/meysam-ghanbari-research-presentation.webp" alt="Meysam Ghanbari giving a professional research presentation" loading="lazy" />
      <div>
        <p class="eyebrow">MEDIA & PRESENTATIONS</p>
        <h2>Professional visual archive</h2>
        <p>Selected portraits, technical environments and presentation imagery support a consistent research identity across the website and image search.</p>
        <a class="text-link large-link" href="/media">Open media library →</a>
      </div>
    </div>
  </section>

  <section class="section section-collaboration">
    <div class="shell collaboration-card">
      <div>
        <p class="eyebrow">ENQUIRIES</p>
        <h2>{c.collaborationTitle}</h2>
        <p>{c.collaborationText}</p>
      </div>
      <a class="button light" href="/contact">{c.collaborationCta}</a>
    </div>
  </section>
</BaseLayout>
